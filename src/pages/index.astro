---
import { Image } from 'astro:assets';
import Ambient from '../components/Ambient.astro';
import ProjectCard from '../components/ProjectCard.astro';
import profilePicture from '../assets/profile_picture.jpg';
import { experience } from '../data/experience';
import { projects } from '../data/projects';

const name = 'Yale Xie';
const links = {
	github: 'https://github.com/yalexie1',
	linkedin: 'https://www.linkedin.com/in/yalexie',
	resume: '/YaleXie_Resume.pdf',
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={`${name} — CS + Math at Yale.`} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Instrument+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<title>{name}</title>
	</head>
	<body>
		<Ambient />

		<header class="site-header">
			<a class="site-name" href="/">{name}</a>
			<nav class="socials" aria-label="Social links">
				<a href={links.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
				<a href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
				<a href={links.resume} target="_blank" rel="noopener noreferrer">Resume ↗</a>
			</nav>
		</header>

		<section class="hero">
			<div class="hero-text">
				<p class="eyebrow">Yale University · New Haven, CT</p>
				<h1>
					<span>Yale</span>
					<em>Xie</em>
				</h1>
			</div>
			<figure class="portrait">
				<Image
					src={profilePicture}
					alt={`Portrait of ${name}`}
					width={720}
					densities={[1, 2]}
					loading="eager"
					fetchpriority="high"
				/>
			</figure>
		</section>

		<main>
			<section class="about" aria-labelledby="about-heading">
				<h2 id="about-heading" class="section-label">About</h2>
				<div class="about-body">
					<p class="lede">
						Hello! I'm Yale Xie, and I'm a freshman studying Computer Science and Mathematics
						at Yale College.
					</p>
					<p>
						If you're wondering, I was not named after the school; rather, it's a phonetic
						spelling of my Chinese name, which is pronounced like "yah-luh". On campus, I'm an
						organizer for YHack and a member of the Yale College Council's Tech Division. I also
						enjoy playing poker at the Yale Poker Club, competing in ping-pong intramurals, and
						exploring Yale's vibrant music scene.
					</p>
					<p>
						My technical background spans AI architectures, full-stack web development, and
						statistical modeling.
					</p>
				</div>
			</section>

			<section class="projects" aria-labelledby="projects-heading">
				<h2 id="projects-heading" class="section-label">Selected Projects</h2>
				<div class="grid">
					{projects.map((project, index) => <ProjectCard project={project} index={index} />)}
				</div>
			</section>

			<section class="experience" aria-labelledby="experience-heading">
				<h2 id="experience-heading" class="section-label">Experience</h2>
				<ol class="timeline">
					{
						experience.map((job) => (
							<li class="job">
								<p class="job-dates">{job.dates}</p>
								<h3>{job.role}</h3>
								<p class="job-company">
									{job.company} · {job.location}
								</p>
								<ul>
									{job.highlights.map((highlight) => {
										if (typeof highlight === 'string') return <li>{highlight}</li>;
										const [before, after] = highlight.text.split(highlight.link.text);
										return (
											<li>
												{before}
												<a href={highlight.link.href} target="_blank" rel="noopener noreferrer">
													{highlight.link.text}
												</a>
												{after}
											</li>
										);
									})}
								</ul>
							</li>
						))
					}
				</ol>
			</section>
		</main>

		<footer>
			<p>© {new Date().getFullYear()} {name}</p>
		</footer>

		<script>
			const header = document.querySelector('.site-header');
			const update = () => header?.classList.toggle('is-hidden', window.scrollY > 80);

			update();
			window.addEventListener('scroll', update, { passive: true });

			// Reveal timeline entries and project cards as they scroll into view
			const reveal = document.querySelectorAll<HTMLElement>('.job, .card');
			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (!reducedMotion && 'IntersectionObserver' in window) {
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							entry.target.classList.replace('will-reveal', 'revealed');
							observer.unobserve(entry.target);
						}
					},
					{ threshold: 0.2 },
				);

				reveal.forEach((el) => {
					if (el.getBoundingClientRect().top < window.innerHeight) return;
					const index = Array.prototype.indexOf.call(el.parentElement?.children ?? [], el);
					el.style.setProperty('--reveal-delay', `${index * 140}ms`);
					el.classList.add('will-reveal');
					observer.observe(el);
				});
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		--paper: #f4f1e8;
		--surface: #fbfaf5;
		--ink: #1c2019;
		--ink-soft: #4d5446;
		--line: #d6d2c2;
		--moss: #4a6b2f;
		--moss-deep: #6f8f3a;
		--amber: #d9a441;
		--firefly: 176, 128, 20;
		--glow-opacity: 0.2;
		--grain-opacity: 0.07;
		--font-display: 'Fraunces', Georgia, serif;
		--font-body: 'Instrument Sans', system-ui, sans-serif;
		--font-mono: 'JetBrains Mono', ui-monospace, monospace;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--paper: #141712;
			--surface: #1b1f18;
			--ink: #ebe8dc;
			--ink-soft: #a9ad9d;
			--line: #343a2e;
			--moss: #9cbf6e;
			--moss-deep: #2f4a1d;
			--amber: #b8862e;
			--firefly: 214, 230, 120;
			--glow-opacity: 0.16;
			--grain-opacity: 0.05;
		}
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		background: var(--paper);
		color: var(--ink);
		font-family: var(--font-body);
		font-size: 17px;
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
	}

	body {
		margin: 0 auto;
		max-width: 1100px;
		padding: 0 1.5rem;
		/* Transparent so the fixed ambient background shows through */
		background: transparent;
	}

	::selection {
		background: var(--moss);
		color: var(--paper);
	}

	a:focus-visible {
		outline: 2px solid var(--moss);
		outline-offset: 3px;
	}

	.will-reveal {
		opacity: 0;
	}

	.revealed {
		animation: reveal 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) var(--reveal-delay, 0ms) backwards;
	}

	@keyframes reveal {
		from {
			opacity: 0;
			transform: translateY(28px);
		}
	}
</style>

<style>
	/* ---------- Header ---------- */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1.25rem 0;
		border-bottom: 1px solid var(--line);
		transition:
			opacity 0.35s ease,
			transform 0.35s ease;
	}

	/* Fades out once you scroll down; comes back near the top or on keyboard focus */
	.site-header.is-hidden:not(:focus-within) {
		opacity: 0;
		transform: translateY(-100%);
		pointer-events: none;
	}

	.site-name {
		font-family: var(--font-display);
		font-size: 1.4rem;
		font-style: italic;
		font-weight: 500;
		color: var(--ink);
		text-decoration: none;
	}

	.site-name:hover {
		color: var(--moss);
	}

	/* ---------- Hero ---------- */
	.hero {
		display: grid;
		grid-template-columns: 1.3fr 1fr;
		align-items: end;
		gap: 3rem;
		padding: 5rem 0 4rem;
		border-bottom: 1px solid var(--line);
	}

	.eyebrow {
		margin: 0 0 1.5rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--moss);
	}

	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(4.5rem, 13vw, 9.5rem);
		font-weight: 300;
		line-height: 0.88;
		letter-spacing: -0.03em;
	}

	h1 span,
	h1 em {
		display: block;
	}

	h1 em {
		font-style: italic;
		color: var(--moss);
		padding-left: 0.6em;
		padding-right: 0.1em;
	}

	/* Light slowly sweeping across the surname */
	@supports (background-clip: text) or (-webkit-background-clip: text) {
		h1 em {
			color: transparent;
			background: linear-gradient(
				110deg,
				var(--moss) 25%,
				var(--amber) 50%,
				var(--moss) 75%
			);
			background-size: 250% 100%;
			background-position: 100% 0;
			-webkit-background-clip: text;
			background-clip: text;
		}
	}

	@keyframes shimmer {
		to {
			background-position: 0% 0;
		}
	}

	.socials {
		display: flex;
		gap: 1.5rem;
	}

	.socials a {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--ink);
		text-decoration: none;
		padding-bottom: 2px;
		border-bottom: 1px solid var(--moss);
		transition: color 0.2s ease;
	}

	.socials a:hover {
		color: var(--moss);
	}

	.portrait {
		margin: 0;
		justify-self: end;
		width: 100%;
		max-width: 360px;
		padding: 0.75rem 0.75rem 2.5rem;
		background: var(--surface);
		border: 1px solid var(--line);
		box-shadow: 10px 10px 0 var(--moss);
		transform: rotate(2deg);
		transition: transform 0.4s ease;
	}

	.portrait:hover {
		transform: rotate(0deg);
	}

	.portrait img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: 30% 50%;
	}

	/* ---------- Sections ---------- */
	main section {
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: 2rem;
		padding: 4.5rem 0;
		border-bottom: 1px solid var(--line);
	}

	/* ---------- Experience (left-to-right timeline, newest first) ---------- */
	/* Heading on its own line above full-width content */
	main section.experience,
	main section.projects {
		grid-template-columns: 1fr;
	}

	.timeline {
		--timeline-gap: 2.5rem;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--timeline-gap);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.job {
		position: relative;
		padding-top: 2rem;
	}

	/* Timeline rail, extended across the gap so it reads as one continuous line */
	.job::after {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: calc(100% + var(--timeline-gap));
		border-top: 1px solid var(--line);
	}

	.job:last-child::after {
		width: 100%;
	}

	/* Timeline node; the most recent role is filled in */
	.job::before {
		content: '';
		position: absolute;
		z-index: 1;
		top: -6px;
		left: 0;
		width: 11px;
		height: 11px;
		border: 1px solid var(--moss);
		border-radius: 50%;
		background: var(--paper);
	}

	.job:first-child::before {
		background: var(--moss);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--moss) 25%, transparent);
	}

	/* As each role scrolls in, its stretch of rail draws left to right and its node pops in */
	.job::after {
		transform-origin: left;
	}

	.job.will-reveal::after {
		transform: scaleX(0);
	}

	.job.revealed::after {
		animation: draw-rail 1.1s cubic-bezier(0.6, 0, 0.2, 1) var(--reveal-delay, 0ms) backwards;
	}

	.job.revealed::before {
		animation: pop-node 0.5s cubic-bezier(0.3, 1.6, 0.5, 1) calc(var(--reveal-delay, 0ms) + 0.15s) backwards;
	}

	@keyframes draw-rail {
		from {
			transform: scaleX(0);
		}
	}

	@keyframes pop-node {
		from {
			transform: scale(0);
		}
	}

	.job-dates {
		margin: 0 0 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		color: var(--moss);
	}

	.job h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.45rem;
		font-weight: 500;
		line-height: 1.15;
	}

	.job-company {
		margin: 0.35rem 0 1.25rem;
		font-size: 0.9rem;
		color: var(--ink-soft);
	}

	.job ul {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin: 0;
		padding-left: 1rem;
		font-size: 0.88rem;
		line-height: 1.55;
		color: var(--ink-soft);
	}

	.job ul li::marker {
		color: var(--moss);
	}

	.job ul a {
		color: var(--ink);
		text-decoration: none;
		border-bottom: 1px solid var(--moss);
	}

	.job ul a:hover {
		color: var(--moss);
	}

	.section-label {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--ink-soft);
	}

	.about-body {
		max-width: 62ch;
	}

	.about-body p {
		margin: 0 0 1.25rem;
		color: var(--ink-soft);
	}

	.about-body .lede {
		font-family: var(--font-display);
		font-size: 1.9rem;
		font-weight: 400;
		line-height: 1.25;
		color: var(--ink);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.75rem;
	}

	/* ---------- Footer ---------- */
	footer {
		display: flex;
		justify-content: center;
		padding: 2.5rem 0 3rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--ink-soft);
	}

	footer p {
		margin: 0;
	}

	/* ---------- Load animation ---------- */
	@media (prefers-reduced-motion: no-preference) {
		.site-header,
		.eyebrow,
		h1 span,
		h1 em,
		.portrait,
		main section {
			animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
		}
		h1 span { animation-delay: 0.08s; }
		h1 em {
			animation:
				rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.16s backwards,
				shimmer 9s ease-in-out 1s infinite alternate;
		}
		.portrait { animation-name: rise-tilt; animation-delay: 0.2s; }
		main section:nth-child(1) { animation-delay: 0.35s; }
		main section:nth-child(2) { animation-delay: 0.45s; }
		main section:nth-child(3) { animation-delay: 0.55s; }
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
	}

	@keyframes rise-tilt {
		from {
			opacity: 0;
			transform: translateY(16px) rotate(6deg);
		}
	}

	/* ---------- Responsive ---------- */
	@media (max-width: 760px) {
		.hero {
			grid-template-columns: 1fr;
			padding: 3rem 0;
			gap: 2.5rem;
		}

		.socials {
			gap: 1rem;
		}

		.socials a {
			font-size: 0.75rem;
		}

		.portrait {
			order: -1;
			justify-self: start;
			max-width: 240px;
		}

		main section {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			padding: 3rem 0;
		}

		/* Keep the timeline horizontal on small screens: swipe through roles */
		.timeline {
			--timeline-gap: 1.5rem;
			grid-template-columns: repeat(3, 82%);
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			padding-top: 6px;
			padding-bottom: 1rem;
		}

		.job {
			scroll-snap-align: start;
		}
	}
</style>
