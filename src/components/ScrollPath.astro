---
// A helix coiling down behind the page that draws itself as you scroll,
// with a glowing tip that keeps pace with the reader. The strands behind
// the coil's axis are drawn thinner and fainter so it reads as 3D.
---

<div class="scroll-path" aria-hidden="true">
	<svg>
		<path class="trail-ahead" />
		<path class="trail trail-back" />
		<path class="trail trail-front" />
		<circle class="tip-halo" r="18" />
		<circle class="tip" r="5" />
	</svg>
</div>

<script>
	const layer = document.querySelector<HTMLElement>('.scroll-path');
	const svg = layer?.querySelector('svg');
	const ahead = layer?.querySelector<SVGPathElement>('.trail-ahead');
	const back = layer?.querySelector<SVGPathElement>('.trail-back');
	const front = layer?.querySelector<SVGPathElement>('.trail-front');
	const tip = layer?.querySelector<SVGCircleElement>('.tip');
	const halo = layer?.querySelector<SVGCircleElement>('.tip-halo');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (layer && svg && ahead && back && front && tip && halo) {
		// Points along the helix in order, with the distance travelled so far on
		// the front and back strands, its depth, and its height along the axis
		let samples: { x: number; y: number; axial: number; depth: number; front: number; back: number }[] = [];
		let frontLength = 0;
		let backLength = 0;
		let pending = false;

		const build = () => {
			const width = document.documentElement.clientWidth;
			const height = document.body.offsetHeight;
			layer.style.height = `${height}px`;
			svg.setAttribute('viewBox', `0 0 ${width} ${height}`);

			// One full turn every ~620px, swinging out toward the page edges
			const pitch = 620;
			const margin = Math.max(24, width * 0.06);
			const radius = (width / 2 - margin) * 0.92;
			const rise = pitch / (Math.PI * 2);
			// Tilting the coil toward the viewer: strong enough that the back of
			// each turn loops over itself, which is what sells the spiral
			const tilt = rise * 2.4;
			// End a little above the bottom so the tip stays fully visible
			const end = height - 32;
			const start = Math.PI / 2;
			const step = Math.min(0.08, 5 / radius);

			samples = [];
			let d = '';
			let frontD = '';
			let backD = '';
			let wasFront: boolean | null = null;
			let prev: { x: number; y: number } | null = null;
			frontLength = 0;
			backLength = 0;

			for (let theta = start; ; theta += step) {
				const axial = rise * (theta - start);
				const x = width / 2 + radius * Math.cos(theta);
				const y = axial + tilt * (Math.sin(theta) - 1);
				const depth = Math.sin(theta);
				const isFront = depth >= 0;
				const point = `${x.toFixed(1)} ${y.toFixed(1)}`;

				d += prev ? ` L ${point}` : `M ${point}`;
				if (prev) {
					const seg = Math.hypot(x - prev.x, y - prev.y);
					// Each strand is a run of separate pieces; start a new piece when we cross sides
					const from = `${prev.x.toFixed(1)} ${prev.y.toFixed(1)}`;
					if (isFront) {
						frontD += wasFront ? ` L ${point}` : ` M ${from} L ${point}`;
						frontLength += seg;
					} else {
						backD += wasFront === false ? ` L ${point}` : ` M ${from} L ${point}`;
						backLength += seg;
					}
				}
				wasFront = isFront;
				prev = { x, y };
				samples.push({ x, y, axial, depth, front: frontLength, back: backLength });
				if (axial >= end) break;
			}

			ahead.setAttribute('d', d);
			for (const [path, d, length] of [
				[front, frontD, frontLength],
				[back, backD, backLength],
			] as const) {
				path.setAttribute('d', d || 'M 0 0');
				// Measure dashes in our own units so they line up with the sample distances
				path.setAttribute('pathLength', `${Math.max(length, 1)}`);
				path.style.strokeDasharray = `${Math.max(length, 1)}`;
			}

			update();
		};

		const update = () => {
			pending = false;
			if (!samples.length) return;

			// The tip sits a bit below the middle of the screen, then slides down to
			// the very end of the path as you reach the bottom of the page
			const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
			const progress = maxScroll > 0 ? Math.min(1, window.scrollY / maxScroll) : 1;
			const target = reducedMotion
				? Infinity
				: window.scrollY + window.innerHeight * (0.55 + 0.45 * progress);

			// The coil loops back on itself, but its height along the axis only
			// grows, so binary search on that
			let lo = 0;
			let hi = samples.length - 1;
			while (lo < hi) {
				const mid = (lo + hi) >> 1;
				if (samples[mid].axial < target) lo = mid + 1;
				else hi = mid;
			}
			const point = samples[lo];

			front.style.strokeDashoffset = `${Math.max(frontLength, 1) - point.front}`;
			back.style.strokeDashoffset = `${Math.max(backLength, 1) - point.back}`;
			// The tip swells as it swings toward you and shrinks round the back
			const scale = 0.75 + 0.35 * point.depth;
			tip.setAttribute('r', `${5 * scale}`);
			halo.setAttribute('r', `${18 * scale}`);
			for (const circle of [tip, halo]) {
				circle.setAttribute('cx', `${point.x}`);
				circle.setAttribute('cy', `${point.y}`);
			}
		};

		const schedule = () => {
			if (pending) return;
			pending = true;
			requestAnimationFrame(update);
		};

		build();
		window.addEventListener('scroll', schedule, { passive: true });
		// Rebuild when the page size changes (resize, fonts or images loading)
		new ResizeObserver(build).observe(document.body);
	}
</script>

<style>
	.scroll-path {
		position: absolute;
		top: 0;
		left: 0;
		z-index: -1;
		width: 100%;
		pointer-events: none;
	}

	svg {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	path {
		fill: none;
		stroke-linecap: round;
	}

	/* Faint dotted preview of the route still to come */
	.trail-ahead {
		stroke: var(--moss);
		stroke-width: 2;
		stroke-dasharray: 2 12;
		opacity: var(--path-ahead-opacity);
	}

	/* The part you've already travelled */
	.trail {
		stroke: var(--moss);
	}

	.trail-front {
		stroke-width: 3.5;
		opacity: var(--path-opacity);
	}

	/* Strands behind the coil's axis recede */
	.trail-back {
		stroke-width: 1.75;
		opacity: calc(var(--path-opacity) * 0.5);
	}

	.tip {
		fill: var(--moss);
		opacity: 0.85;
	}

	.tip-halo {
		fill: var(--moss);
		opacity: 0.18;
		transform-box: fill-box;
		transform-origin: center;
		animation: breathe 2.4s ease-in-out infinite;
	}

	@keyframes breathe {
		50% {
			transform: scale(1.6);
			opacity: 0.06;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tip,
		.tip-halo {
			display: none;
		}
	}
</style>
