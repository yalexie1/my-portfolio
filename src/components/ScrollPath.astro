---
// A winding trail behind the page that draws itself as you scroll, with a
// glowing tip that keeps pace with the reader. The travelled trail is a rope
// of strands that keep twisting around each other along the route.
---

<div class="scroll-path" aria-hidden="true">
	<svg>
		<path class="trail-ahead" />
		<g class="strands-back"></g>
		<g class="strands-front"></g>
		<circle class="tip-halo" r="18" />
		<circle class="tip" r="5" />
	</svg>
</div>

<script>
	const layer = document.querySelector<HTMLElement>('.scroll-path');
	const svg = layer?.querySelector('svg');
	const ahead = layer?.querySelector<SVGPathElement>('.trail-ahead');
	const backLayer = layer?.querySelector<SVGGElement>('.strands-back');
	const frontLayer = layer?.querySelector<SVGGElement>('.strands-front');
	const tip = layer?.querySelector<SVGCircleElement>('.tip');
	const halo = layer?.querySelector<SVGCircleElement>('.tip-halo');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (layer && svg && ahead && backLayer && frontLayer && tip && halo) {
		const STRANDS = 3;
		// How far the strands swing from the route, and how often they twist
		const RADIUS = 9;
		const TWIST = 110;
		const SPIN = 0.0018;

		// Each strand gets a path for the half of each twist in front of the
		// route and one for the half behind, so crossings read as over and under
		const makeStrands = (group: SVGGElement) =>
			Array.from({ length: STRANDS }, () => {
				const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
				group.append(path);
				return path;
			});
		const backs = makeStrands(backLayer);
		const fronts = makeStrands(frontLayer);

		// Points along the route with their distance along it, and the
		// direction to push strands out sideways
		let samples: { at: number; x: number; y: number; nx: number; ny: number }[] = [];
		let reached = 0;
		let frame = 0;

		// Deterministic wobble so the path keeps its shape between visits
		const wobble = (i: number) => {
			const v = Math.sin(i * 12.9898) * 43758.5453;
			return v - Math.floor(v);
		};

		const build = () => {
			const width = document.documentElement.clientWidth;
			const height = document.body.offsetHeight;
			layer.style.height = `${height}px`;
			svg.setAttribute('viewBox', `0 0 ${width} ${height}`);

			// Swing side to side every ~520px, reaching toward the page edges
			const step = 520;
			const margin = Math.max(24, width * 0.06);
			// End a little above the bottom so the tip stays fully visible
			const end = height - 32;
			const points: [number, number][] = [[width * 0.5, 0]];
			for (let i = 1, y = step; points[points.length - 1][1] < end; i++, y += step) {
				const side = i % 2 ? 1 : 0;
				const reach = 0.55 + wobble(i) * 0.45;
				const x = side
					? width / 2 + (width / 2 - margin) * reach
					: width / 2 - (width / 2 - margin) * reach;
				points.push([x, Math.min(y, end)]);
			}

			let d = `M ${points[0][0]} ${points[0][1]}`;
			for (let i = 1; i < points.length; i++) {
				const [x0, y0] = points[i - 1];
				const [x1, y1] = points[i];
				const bend = (y1 - y0) * 0.55;
				d += ` C ${x0} ${y0 + bend}, ${x1} ${y1 - bend}, ${x1} ${y1}`;
			}
			ahead.setAttribute('d', d);

			const length = ahead.getTotalLength();
			const count = Math.ceil(length / 4);
			const route = Array.from({ length: count + 1 }, (_, i) => {
				const at = (length * i) / count;
				const p = ahead.getPointAtLength(at);
				return { at, x: p.x, y: p.y };
			});
			samples = route.map((p, i) => {
				const a = route[Math.max(0, i - 1)];
				const b = route[Math.min(count, i + 1)];
				const span = Math.hypot(b.x - a.x, b.y - a.y) || 1;
				return { ...p, nx: -(b.y - a.y) / span, ny: (b.x - a.x) / span };
			});

			update();
		};

		// Index of the first sample at or below a given height (the route only moves downward)
		const findY = (y: number) => {
			let lo = 0;
			let hi = samples.length - 1;
			while (lo < hi) {
				const mid = (lo + hi) >> 1;
				if (samples[mid].y < y) lo = mid + 1;
				else hi = mid;
			}
			return lo;
		};

		// Redraw the strands up to the tip, twisted by the current spin. Only the
		// stretch on screen is drawn, which keeps each frame cheap on long pages
		const draw = (time: number) => {
			const spin = reducedMotion ? 0 : time * SPIN;
			const first = Math.max(0, findY(window.scrollY - 100) - 1);
			const last = Math.min(reached, findY(window.scrollY + window.innerHeight + 100));
			for (let k = 0; k < STRANDS; k++) {
				const offset = (k / STRANDS) * Math.PI * 2;
				let front = '';
				let back = '';
				let px = 0;
				let py = 0;
				let pc = 0;
				for (let i = first; i <= last; i++) {
					const s = samples[i];
					const angle = (s.at / TWIST) * Math.PI * 2 + offset - spin;
					const shift = Math.sin(angle) * RADIUS;
					const x = s.x + s.nx * shift;
					const y = s.y + s.ny * shift;
					// Depth: positive in front of the route, negative behind it
					const c = Math.cos(angle);
					const point = ` L${x.toFixed(2)} ${y.toFixed(2)}`;
					if (i === first) {
						const start = ` M${x.toFixed(2)} ${y.toFixed(2)}`;
						if (c >= 0) front += start;
						else back += start;
					} else if (c >= 0 === pc >= 0) {
						if (c >= 0) front += point;
						else back += point;
					} else {
						// The strand passes over or under between these samples: find
						// exactly where, so the switch glides rather than jumping a sample
						const t = pc / (pc - c);
						const cross = `${(px + (x - px) * t).toFixed(2)} ${(py + (y - py) * t).toFixed(2)}`;
						if (c >= 0) {
							back += ` L${cross}`;
							front += ` M${cross}${point}`;
						} else {
							front += ` L${cross}`;
							back += ` M${cross}${point}`;
						}
					}
					px = x;
					py = y;
					pc = c;
				}
				fronts[k].setAttribute('d', front || 'M0 0');
				backs[k].setAttribute('d', back || 'M0 0');
			}
		};

		const loop = (time: number) => {
			draw(time);
			frame = requestAnimationFrame(loop);
		};

		const update = () => {
			if (!samples.length) return;

			// The tip sits a bit below the middle of the screen, then slides down to
			// the very end of the path as you reach the bottom of the page
			const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
			const progress = maxScroll > 0 ? Math.min(1, window.scrollY / maxScroll) : 1;
			const target = reducedMotion
				? Infinity
				: window.scrollY + window.innerHeight * (0.55 + 0.45 * progress);

			reached = findY(target);
			const point = samples[reached];
			if (reducedMotion) draw(0);

			for (const circle of [tip, halo]) {
				circle.setAttribute('cx', `${point.x}`);
				circle.setAttribute('cy', `${point.y}`);
			}
		};

		build();
		window.addEventListener('scroll', update, { passive: true });
		if (!reducedMotion) {
			frame = requestAnimationFrame(loop);
			// Pause the twisting when the tab isn't visible
			document.addEventListener('visibilitychange', () => {
				cancelAnimationFrame(frame);
				if (!document.hidden) frame = requestAnimationFrame(loop);
			});
		}
		// Rebuild when the page size changes (resize, fonts or images loading)
		new ResizeObserver(build).observe(document.body);
	}
</script>

<style>
	.scroll-path {
		position: absolute;
		top: 0;
		left: 0;
		z-index: -1;
		width: 100%;
		pointer-events: none;
	}

	svg {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	:global(.scroll-path path) {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* Faint dotted preview of the route still to come */
	.trail-ahead {
		stroke: var(--moss);
		stroke-width: 2;
		stroke-dasharray: 2 12;
		opacity: var(--path-ahead-opacity);
	}

	/* The part you've already travelled: strands twisting over and under */
	.strands-front :global(path) {
		stroke-linecap: butt;
		stroke: var(--moss);
		stroke-width: 2.5;
		opacity: var(--path-opacity);
	}

	.strands-back :global(path) {
		stroke-linecap: butt;
		stroke: var(--moss);
		stroke-width: 1.5;
		opacity: calc(var(--path-opacity) * 0.45);
	}

	.tip {
		fill: var(--moss);
		opacity: 0.85;
	}

	.tip-halo {
		fill: var(--moss);
		opacity: 0.18;
		transform-box: fill-box;
		transform-origin: center;
		animation: breathe 2.4s ease-in-out infinite;
	}

	@keyframes breathe {
		50% {
			transform: scale(1.6);
			opacity: 0.06;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tip,
		.tip-halo {
			display: none;
		}
	}
</style>
