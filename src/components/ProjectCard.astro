---
import type { Project } from '../data/projects';

interface Props {
	project: Project;
	index: number;
}

const { project, index } = Astro.props;
const number = String(index + 1).padStart(2, '0');
// Clicking the card opens the live site, or the repo when there isn't one
const cardHref = project.live ?? project.repo;
---

<article class="card clickable">
	<span class="ghost-number" aria-hidden="true">{number}</span>
	<span class="number" aria-hidden="true">{number}</span>
	<h3>
		<a class="card-link" href={cardHref} target="_blank" rel="noopener noreferrer">
			{project.title}
		</a>
	</h3>
	<p>{project.description}</p>
	<div class="links">
		<a href={project.repo} target="_blank" rel="noopener noreferrer">Source ↗</a>
	</div>
</article>

<script>
	// Spotlight and glare follow the cursor; with a mouse, the card also tilts toward it.
	// Motion is eased in a single requestAnimationFrame loop per card rather than with CSS
	// transitions, which restart on every pointermove and make the tilt stutter.
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const EASE = 0.14; // fraction of the remaining distance covered each frame

	document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
		const ghost = card.querySelector<HTMLElement>('.ghost-number');
		const current = { rx: 0, ry: 0, px: 0, py: 0, lift: 0 };
		const target = { ...current };
		let frame = 0;
		let spot: { x: number; y: number } | null = null;

		const step = () => {
			let moving = false;
			for (const key of Object.keys(current) as (keyof typeof current)[]) {
				const delta = target[key] - current[key];
				if (Math.abs(delta) > 0.001) {
					current[key] += delta * EASE;
					moving = true;
				} else {
					current[key] = target[key];
				}
			}

			card.style.transform =
				`perspective(900px) rotateX(${current.rx.toFixed(3)}deg) ` +
				`rotateY(${current.ry.toFixed(3)}deg) translateY(${(current.lift * -6).toFixed(2)}px)`;
			if (ghost) {
				ghost.style.transform = `translate(${(current.px * -14).toFixed(2)}px, ${(current.py * -10).toFixed(2)}px)`;
			}
			if (spot) {
				card.style.setProperty('--mx', `${spot.x}px`);
				card.style.setProperty('--my', `${spot.y}px`);
				spot = null;
			}

			frame = moving ? requestAnimationFrame(step) : 0;
		};

		const kick = () => {
			if (!frame) frame = requestAnimationFrame(step);
		};

		card.addEventListener('pointermove', (event) => {
			const rect = card.getBoundingClientRect();
			const x = event.clientX - rect.left;
			const y = event.clientY - rect.top;
			spot = { x, y };

			if (!reducedMotion && event.pointerType === 'mouse') {
				// -0.5 … 0.5 from the card's centre
				target.px = x / rect.width - 0.5;
				target.py = y / rect.height - 0.5;
				target.rx = -target.py * 9;
				target.ry = target.px * 11;
				target.lift = 1;
			}
			kick();
		});

		card.addEventListener('pointerleave', () => {
			Object.assign(target, { rx: 0, ry: 0, px: 0, py: 0, lift: 0 });
			kick();
		});
	});
</script>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 2rem 1.75rem 1.75rem;
		overflow: hidden;
		/* Own stacking context so the decorative layers can sit behind the text */
		isolation: isolate;
		/* Mostly opaque instead of a live backdrop blur, which would re-blur every frame while tilting */
		background: color-mix(in srgb, var(--surface) 86%, transparent);
		border: 1px solid var(--line);
		border-radius: 10px;
		/* Resting depth: a soft stacked shadow plus a faint lit top edge */
		box-shadow:
			inset 0 1px 0 color-mix(in srgb, var(--ink) 8%, transparent),
			0 1px 2px rgb(0 0 0 / 0.12),
			0 8px 24px -12px rgb(0 0 0 / 0.35);
		/* Tilt and lift are applied from the script; the shadow only changes once, on hover */
		transition:
			box-shadow 0.4s ease,
			border-color 0.4s ease;
	}

	.card:hover {
		border-color: transparent;
		will-change: transform;
		box-shadow:
			inset 0 1px 0 color-mix(in srgb, var(--ink) 14%, transparent),
			0 22px 40px -14px rgb(0 0 0 / 0.55),
			0 0 0 1px color-mix(in srgb, var(--moss) 35%, transparent),
			0 0 40px -10px color-mix(in srgb, var(--moss) 45%, transparent);
	}

	/* Gradient edge that lights up on hover */
	.card::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		padding: 1px;
		border-radius: inherit;
		background: linear-gradient(
			135deg,
			var(--moss),
			transparent 40%,
			transparent 60%,
			var(--amber)
		);
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask-composite: exclude;
		opacity: 0;
		transition: opacity 0.4s ease;
		pointer-events: none;
	}

	.card:hover::after {
		opacity: 1;
	}

	/* Oversized outlined number behind the text, drifting against the tilt for parallax */
	.ghost-number {
		position: absolute;
		right: -0.5rem;
		bottom: -2.2rem;
		z-index: -1;
		font-family: var(--font-display);
		font-size: 9rem;
		font-weight: 600;
		font-style: italic;
		line-height: 1;
		color: transparent;
		-webkit-text-stroke: 1px color-mix(in srgb, var(--moss) 30%, transparent);
		text-shadow: none;
		transition: -webkit-text-stroke-color 0.4s ease;
		pointer-events: none;
		user-select: none;
	}

	.card:hover .ghost-number {
		-webkit-text-stroke-color: color-mix(in srgb, var(--moss) 55%, transparent);
	}

	.clickable {
		cursor: pointer;
	}

	/* Behind the text, within the card's isolated stacking context */
	.card::before {
		content: '';
		position: absolute;
		z-index: -1;
		inset: 0;
		border-radius: inherit;
		background:
			/* Glare: a small bright sheen right under the cursor */
			radial-gradient(
				160px circle at var(--mx, 50%) var(--my, 50%),
				color-mix(in srgb, var(--ink) 9%, transparent),
				transparent 70%
			),
			/* Spotlight: a wider moss glow */
			radial-gradient(
				360px circle at var(--mx, 50%) var(--my, 50%),
				color-mix(in srgb, var(--moss) 22%, transparent),
				transparent 65%
			);
		opacity: 0;
		transition: opacity 0.3s ease;
		pointer-events: none;
	}

	.card:hover::before {
		opacity: 1;
	}

	.number {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		color: var(--moss);
	}

	h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 500;
		line-height: 1.1;
	}

	/* Stretch the title link over the whole card so clicking anywhere opens the live site */
	.card-link {
		color: inherit;
		text-decoration: none;
	}

	.card-link::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	.card:hover .card-link {
		color: var(--moss);
	}

	.card-link:focus-visible {
		outline: none;
	}

	.card:has(.card-link:focus-visible) {
		outline: 2px solid var(--moss);
		outline-offset: 3px;
	}

	p {
		margin: 0;
		color: var(--ink-soft);
		flex-grow: 1;
	}

	.links {
		padding-top: 1rem;
		border-top: 1px dashed var(--line);
	}

	/* Sit above the stretched card link so it stays independently clickable */
	.links a {
		position: relative;
		z-index: 1;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--ink);
		text-decoration: none;
		border-bottom: 1px solid var(--moss);
	}

	.links a:hover {
		color: var(--moss);
	}
</style>
