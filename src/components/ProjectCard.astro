---
import type { Project } from '../data/projects';

interface Props {
	project: Project;
	index: number;
}

const { project, index } = Astro.props;
const number = String(index + 1).padStart(2, '0');
// Clicking the card opens the live site, or the repo when there isn't one
const cardHref = project.live ?? project.repo;
---

<article class="card clickable">
	<span class="ghost-number" aria-hidden="true">{number}</span>
	<span class="number" aria-hidden="true">{number}</span>
	<h3>
		<a class="card-link" href={cardHref} target="_blank" rel="noopener noreferrer">
			{project.title}
		</a>
	</h3>
	<p>{project.description}</p>
	<div class="links">
		<a href={project.repo} target="_blank" rel="noopener noreferrer">Source ↗</a>
	</div>
</article>

<script>
	// Spotlight and glare follow the cursor; with a mouse, the card also tilts toward it
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
		card.addEventListener('pointermove', (event) => {
			const rect = card.getBoundingClientRect();
			const x = event.clientX - rect.left;
			const y = event.clientY - rect.top;
			card.style.setProperty('--mx', `${x}px`);
			card.style.setProperty('--my', `${y}px`);

			if (reducedMotion || event.pointerType !== 'mouse') return;
			// -0.5 … 0.5 from the card's centre
			const px = x / rect.width - 0.5;
			const py = y / rect.height - 0.5;
			card.style.setProperty('--rx', `${(-py * 9).toFixed(2)}deg`);
			card.style.setProperty('--ry', `${(px * 11).toFixed(2)}deg`);
			card.style.setProperty('--px', px.toFixed(3));
			card.style.setProperty('--py', py.toFixed(3));
			card.classList.add('is-tilting');
		});

		card.addEventListener('pointerleave', () => {
			card.classList.remove('is-tilting');
			for (const prop of ['--rx', '--ry', '--px', '--py']) card.style.removeProperty(prop);
		});
	});
</script>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 2rem 1.75rem 1.75rem;
		overflow: hidden;
		background: color-mix(in srgb, var(--surface) 72%, transparent);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border: 1px solid var(--line);
		border-radius: 10px;
		/* Resting depth: a soft stacked shadow plus a faint lit top edge */
		box-shadow:
			inset 0 1px 0 color-mix(in srgb, var(--ink) 8%, transparent),
			0 1px 2px rgb(0 0 0 / 0.12),
			0 8px 24px -12px rgb(0 0 0 / 0.35);
		transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
		transition:
			transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
			box-shadow 0.4s ease,
			border-color 0.4s ease;
	}

	/* Lifted: the shadow falls away from the cursor, as if lit from where you point */
	.card:hover {
		border-color: transparent;
		transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) translateY(-6px);
		box-shadow:
			inset 0 1px 0 color-mix(in srgb, var(--ink) 14%, transparent),
			calc(var(--px, 0) * -28px) calc(22px + var(--py, 0) * -20px) 40px -14px rgb(0 0 0 / 0.55),
			0 0 0 1px color-mix(in srgb, var(--moss) 35%, transparent),
			0 0 40px -10px color-mix(in srgb, var(--moss) 45%, transparent);
	}

	/* Follow the cursor closely while tilting, then ease back on leave */
	.card.is-tilting {
		transition:
			transform 0.12s linear,
			box-shadow 0.12s linear,
			border-color 0.4s ease;
	}

	/* Gradient edge that lights up on hover */
	.card::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		padding: 1px;
		border-radius: inherit;
		background: linear-gradient(
			calc(135deg + var(--ry, 0deg) * 6),
			var(--moss),
			transparent 40%,
			transparent 60%,
			var(--amber)
		);
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask-composite: exclude;
		opacity: 0;
		transition: opacity 0.4s ease;
		pointer-events: none;
	}

	.card:hover::after {
		opacity: 1;
	}

	/* Oversized outlined number behind the text, drifting against the tilt for parallax */
	.ghost-number {
		position: absolute;
		right: -0.5rem;
		bottom: -2.2rem;
		z-index: -1;
		font-family: var(--font-display);
		font-size: 9rem;
		font-weight: 600;
		font-style: italic;
		line-height: 1;
		color: transparent;
		-webkit-text-stroke: 1px color-mix(in srgb, var(--moss) 30%, transparent);
		text-shadow: none;
		transform: translate(calc(var(--px, 0) * -14px), calc(var(--py, 0) * -10px));
		transition:
			transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
			-webkit-text-stroke-color 0.4s ease;
		pointer-events: none;
		user-select: none;
	}

	.card.is-tilting .ghost-number {
		transition: transform 0.12s linear;
	}

	.card:hover .ghost-number {
		-webkit-text-stroke-color: color-mix(in srgb, var(--moss) 55%, transparent);
	}

	.clickable {
		cursor: pointer;
	}

	/* Behind the text; backdrop-filter makes the card its own stacking context */
	.card::before {
		content: '';
		position: absolute;
		z-index: -1;
		inset: 0;
		border-radius: inherit;
		background:
			/* Glare: a small bright sheen right under the cursor */
			radial-gradient(
				160px circle at var(--mx, 50%) var(--my, 50%),
				color-mix(in srgb, var(--ink) 9%, transparent),
				transparent 70%
			),
			/* Spotlight: a wider moss glow */
			radial-gradient(
				360px circle at var(--mx, 50%) var(--my, 50%),
				color-mix(in srgb, var(--moss) 22%, transparent),
				transparent 65%
			);
		opacity: 0;
		transition: opacity 0.3s ease;
		pointer-events: none;
	}

	.card:hover::before {
		opacity: 1;
	}

	.number {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		color: var(--moss);
	}

	h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 500;
		line-height: 1.1;
	}

	/* Stretch the title link over the whole card so clicking anywhere opens the live site */
	.card-link {
		color: inherit;
		text-decoration: none;
	}

	.card-link::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	.card:hover .card-link {
		color: var(--moss);
	}

	.card-link:focus-visible {
		outline: none;
	}

	.card:has(.card-link:focus-visible) {
		outline: 2px solid var(--moss);
		outline-offset: 3px;
	}

	p {
		margin: 0;
		color: var(--ink-soft);
		flex-grow: 1;
	}

	.links {
		padding-top: 1rem;
		border-top: 1px dashed var(--line);
	}

	/* Sit above the stretched card link so it stays independently clickable */
	.links a {
		position: relative;
		z-index: 1;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--ink);
		text-decoration: none;
		border-bottom: 1px solid var(--moss);
	}

	.links a:hover {
		color: var(--moss);
	}
</style>
