---
import type { Project } from '../data/projects';

interface Props {
	project: Project;
	index: number;
}

const { project, index } = Astro.props;
const number = String(index + 1).padStart(2, '0');
---

<article class:list={['card', { clickable: project.live }]}>
	<span class="number" aria-hidden="true">{number}</span>
	<h3>
		{project.live ? (
			<a class="card-link" href={project.live} target="_blank" rel="noopener noreferrer">
				{project.title}
			</a>
		) : (
			project.title
		)}
	</h3>
	<p>{project.description}</p>
	<div class="links">
		<a href={project.repo} target="_blank" rel="noopener noreferrer">Source ↗</a>
	</div>
</article>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 2rem 1.75rem 1.75rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 4px;
		transition:
			transform 0.3s ease,
			box-shadow 0.3s ease,
			border-color 0.3s ease;
	}

	.card:hover {
		transform: translateY(-4px);
		border-color: var(--moss);
		box-shadow: 6px 6px 0 var(--moss);
	}

	.clickable {
		cursor: pointer;
	}

	.number {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		color: var(--moss);
	}

	h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 500;
		line-height: 1.1;
	}

	/* Stretch the title link over the whole card so clicking anywhere opens the live site */
	.card-link {
		color: inherit;
		text-decoration: none;
	}

	.card-link::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	.card:hover .card-link {
		color: var(--moss);
	}

	.card-link:focus-visible {
		outline: none;
	}

	.card:has(.card-link:focus-visible) {
		outline: 2px solid var(--moss);
		outline-offset: 3px;
	}

	p {
		margin: 0;
		color: var(--ink-soft);
		flex-grow: 1;
	}

	.links {
		padding-top: 1rem;
		border-top: 1px dashed var(--line);
	}

	/* Sit above the stretched card link so it stays independently clickable */
	.links a {
		position: relative;
		z-index: 1;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--ink);
		text-decoration: none;
		border-bottom: 1px solid var(--moss);
	}

	.links a:hover {
		color: var(--moss);
	}
</style>
