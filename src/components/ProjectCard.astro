---
import type { Project } from '../data/projects';

interface Props {
	project: Project;
	index: number;
}

const { project, index } = Astro.props;
const number = String(index + 1).padStart(2, '0');
---

<article class="card">
	<span class="number" aria-hidden="true">{number}</span>
	<h3>{project.title}</h3>
	<p>{project.description}</p>
	<ul class="tags" aria-label="Technologies">
		{project.tags.map((tag) => <li>{tag}</li>)}
	</ul>
	<div class="links">
		<a href={project.repo} target="_blank" rel="noopener noreferrer">Source ↗</a>
		{project.live && (
			<a href={project.live} target="_blank" rel="noopener noreferrer">Live site ↗</a>
		)}
	</div>
</article>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 2rem 1.75rem 1.75rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 4px;
		transition:
			transform 0.3s ease,
			box-shadow 0.3s ease,
			border-color 0.3s ease;
	}

	.card:hover {
		transform: translateY(-4px);
		border-color: var(--moss);
		box-shadow: 6px 6px 0 var(--moss);
	}

	.number {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		color: var(--moss);
	}

	h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 500;
		line-height: 1.1;
	}

	p {
		margin: 0;
		color: var(--ink-soft);
		flex-grow: 1;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tags li {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 0.25rem 0.6rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--ink-soft);
	}

	.links {
		display: flex;
		gap: 1.25rem;
		padding-top: 1rem;
		border-top: 1px dashed var(--line);
	}

	.links a {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--ink);
		text-decoration: none;
		border-bottom: 1px solid var(--moss);
	}

	.links a:hover {
		color: var(--moss);
	}
</style>
