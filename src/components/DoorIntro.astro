---
// Entrance: a round stone door set in a mossy rock archway. Scrolling (or a
// tap, click, or key) pushes in toward the door as it slides open, revealing
// the page behind. Plays once per browser session; add ?intro to replay it.

// Scene is drawn on a 1600×1000 canvas with the door at its centre
const W = 1600;
const H = 1000;
const CX = W / 2;
const CY = H / 2;
// Radius of the opening in the rock, and of the door filling it
const HOLE = 214;
const DOOR = 220;

// Deterministic randomness so the rocks keep their shape between visits
let seed = 7;
const rand = () => {
	seed = (seed * 16807) % 2147483647;
	return (seed - 1) / 2147483646;
};
const between = (lo: number, hi: number) => lo + rand() * (hi - lo);
// Surface detail draws from its own sequence so it doesn't reshape the rocks
let detailSeed = 23;
const detail = () => {
	detailSeed = (detailSeed * 16807) % 2147483647;
	return (detailSeed - 1) / 2147483646;
};
const detailBetween = (lo: number, hi: number) => lo + detail() * (hi - lo);
const f = (n: number) => n.toFixed(1);

// A lumpy closed shape around a centre, smoothed with Catmull-Rom curves
const blob = (cx: number, cy: number, rx: number, ry: number, lumps = 9, jitter = 0.2) => {
	const pts = Array.from({ length: lumps }, (_, i) => {
		const a = (i / lumps) * Math.PI * 2;
		const r = 1 - jitter / 2 + rand() * jitter;
		return [cx + Math.cos(a) * rx * r, cy + Math.sin(a) * ry * r];
	});
	let d = `M${f(pts[0][0])} ${f(pts[0][1])}`;
	for (let i = 0; i < lumps; i++) {
		const p0 = pts[(i - 1 + lumps) % lumps];
		const p1 = pts[i];
		const p2 = pts[(i + 1) % lumps];
		const p3 = pts[(i + 2) % lumps];
		const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
		const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
		d += ` C${f(c1[0])} ${f(c1[1])} ${f(c2[0])} ${f(c2[1])} ${f(p2[0])} ${f(p2[1])}`;
	}
	return d + 'Z';
};

// A rock outline with flat faces and softly rounded corners
const facet = (cx: number, cy: number, rx: number, ry: number, sides = 7, jitter = 0.22, round = 0.13) => {
	const offset = rand() * Math.PI * 2;
	const pts = Array.from({ length: sides }, (_, i) => {
		const a = offset + ((i + between(-0.25, 0.25)) / sides) * Math.PI * 2;
		const r = 1 - jitter / 2 + rand() * jitter;
		return [cx + Math.cos(a) * rx * r, cy + Math.sin(a) * ry * r];
	});
	const lerp = (p: number[], q: number[], t: number) => [p[0] + (q[0] - p[0]) * t, p[1] + (q[1] - p[1]) * t];
	let d = '';
	for (let i = 0; i < sides; i++) {
		const p = pts[i];
		const next = pts[(i + 1) % sides];
		const prev = pts[(i - 1 + sides) % sides];
		const a = lerp(p, prev, round);
		const b = lerp(p, next, round);
		d += `${i ? 'L' : 'M'}${f(a[0])} ${f(a[1])}Q${f(p[0])} ${f(p[1])} ${f(b[0])} ${f(b[1])}`;
	}
	return d + 'Z';
};

// A ragged edge of leaves or shadow: straight spikes in and out
const jagged = (cx: number, cy: number, rx: number, ry: number, points = 14) => {
	let d = '';
	for (let i = 0; i < points * 2; i++) {
		const a = (i / (points * 2)) * Math.PI * 2 + detailBetween(-0.08, 0.08);
		const r = i % 2 ? detailBetween(0.62, 0.8) : detailBetween(0.92, 1.18);
		d += `${i ? 'L' : 'M'}${f(cx + Math.cos(a) * rx * r)} ${f(cy + Math.sin(a) * ry * r)}`;
	}
	return d + 'Z';
};

// A spiky clump of leaves, alternating long and short points
const tuft = (cx: number, cy: number, size: number) => {
	const points = 9 + Math.floor(detail() * 5);
	let d = '';
	for (let i = 0; i < points * 2; i++) {
		const a = (i / (points * 2)) * Math.PI * 2 + detailBetween(-0.15, 0.15);
		const r = size * (i % 2 ? detailBetween(0.25, 0.45) : detailBetween(0.6, 1.15));
		// Points reach up more than down, like leaves growing toward the light
		const squash = Math.sin(a) > 0 ? 0.55 : 1;
		d += `${i ? 'L' : 'M'}${f(cx + Math.cos(a) * r)} ${f(cy + Math.sin(a) * r * squash)}`;
	}
	return d + 'Z';
};

const leafTones = ['var(--door-moss-dark)', 'var(--door-moss)', 'var(--door-moss)', 'var(--door-moss-light)'];

interface Rock {
	id: number;
	cx: number;
	cy: number;
	rx: number;
	ry: number;
	body: string;
	lit: string;
	side: string;
	moss?: string;
	mossShadow?: string;
	tufts: { d: string; fill: string }[];
}

let rockId = 0;
// Light falls from the upper right: a lit top plane, a shadowed lower-left
// face, and a ragged shadow cast by any moss onto the stone below it
const rock = (cx: number, cy: number, rx: number, ry: number, mossy: boolean, angular = true): Rock => {
	const body = angular ? facet(cx, cy, rx, ry, 6 + Math.floor(rand() * 3)) : blob(cx, cy, rx, ry, 9, 0.2);
	const lit = facet(cx + rx * 0.15, cy - ry * 0.55, rx * 0.95, ry * 0.55, 6, 0.3, 0.12);
	const side = facet(cx - rx * 0.55, cy + ry * 0.55, rx * 0.85, ry * 0.75, 6, 0.3, 0.12);
	const moss = mossy ? jagged(cx - rx * 0.05, cy - ry * 0.7, rx * 0.7, ry * 0.3, 16) : undefined;
	const mossShadow = mossy ? jagged(cx - rx * 0.12, cy - ry * 0.5, rx * 0.66, ry * 0.32, 12) : undefined;

	// Leafy clumps along the moss, in a mix of greens
	const tufts = mossy
		? Array.from({ length: Math.round(rx / 20) }, () => ({
				d: tuft(
					cx - rx * 0.05 + rx * 0.7 * detailBetween(-0.85, 0.85),
					cy - ry * 0.7 + ry * 0.3 * detailBetween(-0.9, 0.5),
					rx * detailBetween(0.06, 0.14),
				),
				fill: leafTones[Math.floor(detail() * leafTones.length)],
			}))
		: [];

	return { id: rockId++, cx, cy, rx, ry, body, lit, side, moss, mossShadow, tufts };
};

// Big boulders framing the scene at either side, drawn first
const boulders: Rock[] = [
	rock(120, 250, 300, 230, true),
	rock(90, 640, 280, 260, false),
	rock(250, 960, 360, 200, true),
	rock(1480, 260, 300, 240, true),
	rock(1520, 650, 270, 250, false),
	rock(1350, 970, 360, 190, true),
];

// A ring of stones around the opening, overlapping the door's edge; some
// worn round, most chipped flat
const ring: Rock[] = [];
const ringCount = 15;
for (let i = 0; i < ringCount; i++) {
	const a = (i / ringCount) * Math.PI * 2 - Math.PI / 2 + between(-0.08, 0.08);
	const dist = HOLE + between(48, 70);
	const cx = CX + Math.cos(a) * dist;
	const cy = CY + Math.sin(a) * dist * 0.96;
	ring.push(rock(cx, cy, between(72, 100), between(58, 82), Math.sin(a) < -0.2, i % 3 !== 0));
}

// Hazy rocks far behind, to give the forest floor some depth
const farRocks = [
	[460, 860, 170, 110],
	[600, 930, 120, 80],
	[1130, 880, 150, 100],
	[1010, 950, 110, 70],
	[430, 140, 130, 90],
	[1180, 120, 140, 90],
].map(([x, y, rx, ry]) => facet(x, y, rx, ry, 7, 0.25));

// Tree trunks at two depths: pale and hazy far away, dark and wide up close.
// Each tapers upward, leans a little, and flares into roots near the ground.
const trunk = (x: number, w: number, lean: number, ground: number) => {
	const top = x + lean;
	return [
		`M${f(x - w * 1.1)} ${ground + 40}`,
		`Q${f(x - w * 0.52)} ${ground - 30} ${f(x - w * 0.5)} ${ground - 200}`,
		`L${f(top - w * 0.4)} -500`,
		`L${f(top + w * 0.4)} -500`,
		`L${f(x + w * 0.5)} ${ground - 200}`,
		`Q${f(x + w * 0.52)} ${ground - 30} ${f(x + w * 1.1)} ${ground + 40}`,
		`L${f(x + w * 1.1)} 1500L${f(x - w * 1.1)} 1500Z`,
	].join('');
};

// A tapering limb reaching up and out from the side of a trunk
const branch = (x: number, y: number, w: number, side: number) => {
	const len = w * detailBetween(1.6, 2.6);
	const ex = x + side * len;
	const ey = y - len * detailBetween(0.5, 0.9);
	const thick = w * 0.32;
	return `M${f(x)} ${f(y)}Q${f(x + side * len * 0.5)} ${f(y - thick)} ${f(ex)} ${f(ey)}Q${f(x + side * len * 0.45)} ${f(y + thick * 0.6)} ${f(x)} ${f(y + thick * 2.4)}Z`;
};

const trunks = [
	{ x: 200, w: 30, far: true },
	{ x: 400, w: 26, far: true },
	{ x: 660, w: 22, far: true },
	{ x: 900, w: 18, far: true },
	{ x: 1000, w: 24, far: true },
	{ x: 1230, w: 28, far: true },
	{ x: 1420, w: 32, far: true },
	{ x: 330, w: 74, far: false },
	{ x: 485, w: 48, far: false },
	{ x: 575, w: 32, far: false },
	{ x: 1045, w: 36, far: false },
	{ x: 1160, w: 56, far: false },
	{ x: 1300, w: 82, far: false },
].map((t) => {
	const lean = detailBetween(-0.6, 0.6) * t.w;
	const ground = t.far ? 860 : 1000;
	const sides = t.far ? [] : [detail() < 0.5 ? -1 : 1, detail() < 0.5 ? -1 : 1];
	return {
		...t,
		d: trunk(t.x, t.w, lean, ground),
		branches: sides.map((side, i) => {
			const y = detailBetween(40, 260) + i * 200;
			// Follow the trunk's lean so the limb starts at its edge
			const along = lean * (1 - (y + 500) / (ground + 500));
			return branch(t.x + along + side * t.w * 0.4, y, t.w, side);
		}),
	};
});

// Shafts of light slanting down through the canopy, each swaying slowly
// from where it breaks through the leaves
const shafts = [
	{ x: 520, w: 70 },
	{ x: 700, w: 130 },
	{ x: 960, w: 90 },
	{ x: 1140, w: 60 },
	{ x: 240, w: 50 },
	{ x: 1330, w: 80 },
].map((s, i) => ({
	d: `M${s.x} -400L${s.x + s.w} -400L${s.x + s.w + 520} 1200L${s.x + 340} 1200Z`,
	origin: `${s.x + s.w / 2}px -400px`,
	delay: i * 2.3,
	duration: 11 + (i % 3) * 3,
}));

// Leaf clusters hanging from the canopy along the top
const canopy = Array.from({ length: 16 }, (_, i) => ({
	d: jagged(i * 110 - 40 + detailBetween(-30, 30), detailBetween(-30, 30), detailBetween(90, 150), detailBetween(50, 90), 12),
	near: i % 2 === 0,
}));

// Vines hanging from the stones over the top of the door
const vines = [-2.05, -1.72, -1.25, -0.95].map((a, i) => {
	const x = CX + Math.cos(a) * (HOLE + 30);
	const y = CY + Math.sin(a) * (HOLE + 30);
	const length = 120 + i * 37 + between(0, 50);
	const sway = between(-26, 26);
	const d = `M${f(x)} ${f(y)} C${f(x + sway)} ${f(y + length * 0.35)} ${f(x - sway)} ${f(y + length * 0.7)} ${f(x + sway * 0.4)} ${f(y + length)}`;
	const leaves = Array.from({ length: 6 }, (_, j) => {
		const t = (j + 1) / 7;
		const lx = x + sway * Math.sin(t * Math.PI) * (t < 0.5 ? 1 : -0.6);
		const ly = y + length * t;
		return { x: lx + (j % 2 ? 7 : -7), y: ly, angle: j % 2 ? 35 : -35, size: 7 + rand() * 4 };
	});
	return { d, leaves };
});

// Little clusters of pale flowers on the boulders
const flowerSpots = [
	[150, 120],
	[250, 420],
	[60, 520],
	[330, 830],
	[1440, 120],
	[1350, 420],
	[1560, 520],
	[1270, 850],
];
const flowers = flowerSpots.flatMap(([x, y]) =>
	Array.from({ length: 3 + Math.floor(rand() * 3) }, () => ({
		x: x + between(-34, 34),
		y: y + between(-24, 24),
		r: between(5, 9),
	})),
);

// Door hardware: six spokes around a central octagon, and rivets on the rim
const spokes = [30, 90, 150, 210, 270, 330].map((deg) => {
	const a = (deg * Math.PI) / 180;
	return { x1: CX + Math.cos(a) * 62, y1: CY + Math.sin(a) * 62, x2: CX + Math.cos(a) * 196, y2: CY + Math.sin(a) * 196 };
});
const octagon = (r: number) =>
	Array.from({ length: 8 }, (_, i) => {
		const a = (i / 8) * Math.PI * 2 + Math.PI / 8;
		return `${f(CX + Math.cos(a) * r)},${f(CY + Math.sin(a) * r)}`;
	}).join(' ');
const rivets = Array.from({ length: 24 }, (_, i) => {
	const a = (i / 24) * Math.PI * 2 + Math.PI / 24;
	return { x: CX + Math.cos(a) * 207, y: CY + Math.sin(a) * 207 };
});

// Spread past the edges of the scene so tall phone screens get them too
const fireflies = Array.from({ length: 70 }, () => ({
	x: between(-100, 1700),
	y: between(-350, 1350),
	size: between(1.4, 3.4),
	dx: between(-24, 24),
	dy: between(-30, -8),
	delay: between(0, 8),
	duration: between(4, 9),
}));
---

<div class="door-intro" aria-hidden="true">
	<div class="door-scene">
		<svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice">
			<defs>
				<radialGradient id="door-wall" cx="50%" cy="50%" r="70%">
					<stop offset="0%" stop-color="var(--door-wall-light)" />
					<stop offset="100%" stop-color="var(--door-wall)" />
				</radialGradient>
				<radialGradient id="door-metal" cx="40%" cy="35%" r="75%">
					<stop offset="0%" stop-color="var(--door-metal-light)" />
					<stop offset="100%" stop-color="var(--door-metal)" />
				</radialGradient>
				<!-- Rocks lit from the upper right -->
				<linearGradient id="door-rock-fill" x1="1" y1="0" x2="0.1" y2="1">
					<stop offset="0%" stop-color="var(--door-rock-light)" />
					<stop offset="45%" stop-color="var(--door-rock)" />
					<stop offset="100%" stop-color="var(--door-rock-dark)" />
				</linearGradient>
				<linearGradient id="door-lit" x1="1" y1="0" x2="0" y2="1">
					<stop offset="0%" stop-color="var(--door-rock-light)" stop-opacity="0.95" />
					<stop offset="100%" stop-color="var(--door-rock-light)" stop-opacity="0.15" />
				</linearGradient>
				<radialGradient id="door-ao">
					<stop offset="0%" stop-color="#000" stop-opacity="0.6" />
					<stop offset="100%" stop-color="#000" stop-opacity="0" />
				</radialGradient>
				<radialGradient id="door-halo" gradientUnits="userSpaceOnUse" cx={CX} cy={CY} r={HOLE + 260}>
					<stop offset="45%" stop-color="var(--door-halo)" stop-opacity="0.28" />
					<stop offset="100%" stop-color="var(--door-halo)" stop-opacity="0" />
				</radialGradient>
				<!-- Round trunks: shadowed on the left, catching light on the right -->
				<linearGradient id="door-trunk">
					<stop offset="0%" stop-color="var(--door-trunk-dark)" />
					<stop offset="55%" stop-color="var(--door-trunk)" />
					<stop offset="82%" stop-color="var(--door-trunk-light)" />
					<stop offset="100%" stop-color="var(--door-trunk)" />
				</linearGradient>
				<linearGradient id="door-trunk-far">
					<stop offset="0%" stop-color="var(--door-trunk-far)" />
					<stop offset="80%" stop-color="var(--door-trunk-far-light)" />
					<stop offset="100%" stop-color="var(--door-trunk-far)" />
				</linearGradient>
				<linearGradient id="door-shaft" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0%" stop-color="var(--door-shaft)" stop-opacity="0.2" />
					<stop offset="100%" stop-color="var(--door-shaft)" stop-opacity="0" />
				</linearGradient>
				<linearGradient id="door-fog" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0%" stop-color="var(--door-fog)" stop-opacity="0" />
					<stop offset="100%" stop-color="var(--door-fog)" stop-opacity="0.4" />
				</linearGradient>
				<radialGradient id="door-vignette" gradientUnits="userSpaceOnUse" cx={CX} cy={CY} r="1150">
					<stop offset="35%" stop-color="#000" stop-opacity="0" />
					<stop offset="100%" stop-color="#000" stop-opacity="0.7" />
				</radialGradient>
				<radialGradient id="door-firefly-glow">
					<stop offset="0%" stop-color="var(--door-glow)" stop-opacity="0.75" />
					<stop offset="100%" stop-color="var(--door-glow)" stop-opacity="0" />
				</radialGradient>
				{
					[...boulders, ...ring].map((r) => (
						<clipPath id={`door-rock-${r.id}`}>
							<path d={r.body} />
						</clipPath>
					))
				}
				<!-- Everywhere except the opening, which has to stay clear once the door parts -->
				<clipPath id="door-outside">
					<path
						clip-rule="evenodd"
						d={`M${-W} ${-H}H${W * 2}V${H * 2}H${-W}Z M${CX - HOLE} ${CY} a${HOLE} ${HOLE} 0 1 0 ${HOLE * 2} 0 a${HOLE} ${HOLE} 0 1 0 ${-HOLE * 2} 0Z`}
					/>
				</clipPath>
				<clipPath id="door-hole">
					<circle cx={CX} cy={CY} r={HOLE} />
				</clipPath>
				<clipPath id="door-left-half">
					<rect x="0" y="0" width={CX} height={H} />
				</clipPath>
				<clipPath id="door-right-half">
					<rect x={CX} y="0" width={CX} height={H} />
				</clipPath>
				<g id="door-face">
					<circle cx={CX} cy={CY} r={DOOR} fill="url(#door-metal)" />
					<circle cx={CX} cy={CY} r="196" fill="var(--door-panel)" />
					<circle cx={CX} cy={CY} r="124" fill="none" stroke="var(--door-metal-dark)" stroke-width="2" opacity="0.6" />
					{
						spokes.map((s) => (
							<line x1={f(s.x1)} y1={f(s.y1)} x2={f(s.x2)} y2={f(s.y2)} stroke="var(--door-metal-dark)" stroke-width="26" stroke-linecap="round" />
						))
					}
					{
						spokes.map((s) => (
							<line x1={f(s.x1)} y1={f(s.y1)} x2={f(s.x2)} y2={f(s.y2)} stroke="var(--door-metal-light)" stroke-width="8" stroke-linecap="round" opacity="0.5" />
						))
					}
					<circle cx={CX} cy={CY} r="200" fill="none" stroke="var(--door-metal-dark)" stroke-width="16" />
					<polygon points={octagon(70)} fill="var(--door-metal-dark)" />
					<polygon points={octagon(54)} fill="var(--door-panel)" stroke="var(--door-metal-light)" stroke-width="2" />
					<text x={CX} y={CY + 15} text-anchor="middle" class="door-monogram">YX</text>
					{rivets.map((r) => <circle cx={f(r.x)} cy={f(r.y)} r="3.5" fill="var(--door-metal-light)" />)}
					<path d={blob(CX - 120, CY - 168, 60, 22, 8, 0.5)} fill="var(--door-moss)" opacity="0.75" />
					<path d={blob(CX + 96, CY - 178, 48, 18, 8, 0.5)} fill="var(--door-moss)" opacity="0.7" />
				</g>
			</defs>

			<!-- Dark forest wall with the opening cut out of it -->
			<path
				fill="url(#door-wall)"
				fill-rule="evenodd"
				d={`M${-W} ${-H}H${W * 2}V${H * 2}H${-W}Z M${CX - HOLE} ${CY} a${HOLE} ${HOLE} 0 1 0 ${HOLE * 2} 0 a${HOLE} ${HOLE} 0 1 0 ${-HOLE * 2} 0Z`}
			/>
			<g clip-path="url(#door-outside)">
				{
					trunks
						.filter((t) => t.far)
						.map((t) => <path d={t.d} fill="url(#door-trunk-far)" />)
				}
				{farRocks.map((d) => <path d={d} fill="var(--door-rock-far)" />)}
				<rect x={-W} y="600" width={W * 3} height="800" fill="url(#door-fog)" />
				<g class="door-canopy">
					{
						canopy
							.filter((c) => !c.near)
							.map((c) => <path d={c.d} fill="var(--door-canopy-far)" transform="translate(50 40)" />)
					}
				</g>
				<g class="door-shafts">
					{
						shafts.map((s) => (
							<path
								class="door-shaft"
								d={s.d}
								fill="url(#door-shaft)"
								style={`transform-origin: ${s.origin}; animation-delay: -${s.delay}s; animation-duration: ${s.duration}s`}
							/>
						))
					}
				</g>
				{
					trunks
						.filter((t) => !t.far)
						.map((t) => (
							<g>
								{t.branches.map((d) => <path d={d} fill="url(#door-trunk)" />)}
								<path d={t.d} fill="url(#door-trunk)" />
							</g>
						))
				}
				<g class="door-canopy">
					{canopy.filter((c) => c.near).map((c) => <path d={c.d} fill="var(--door-canopy)" />)}
				</g>
				<circle cx={CX} cy={CY} r={HOLE + 260} fill="url(#door-halo)" />
			</g>

			<!-- The two halves of the door, which slide apart into the rock -->
			<g clip-path="url(#door-hole)">
				<g class="door-left">
					<use href="#door-face" clip-path="url(#door-left-half)" />
				</g>
				<g class="door-right">
					<use href="#door-face" clip-path="url(#door-right-half)" />
				</g>
				<line class="door-seam" x1={CX} y1={CY - HOLE} x2={CX} y2={CY + HOLE} />
			</g>

			{
				[...boulders, ...ring].map((r) => (
					<g>
						<ellipse cx={f(r.cx + r.rx * 0.08)} cy={f(r.cy + r.ry * 0.55)} rx={f(r.rx * 1.2)} ry={f(r.ry * 0.65)} fill="url(#door-ao)" />
						<path d={r.body} fill="url(#door-rock-fill)" />
						<g clip-path={`url(#door-rock-${r.id})`}>
							<path d={r.lit} fill="url(#door-lit)" />
							<path d={r.side} fill="var(--door-rock-dark)" opacity="0.5" />
							{r.mossShadow && <path d={r.mossShadow} fill="var(--door-wall)" opacity="0.45" />}
							{r.moss && <path d={r.moss} fill="var(--door-moss-dark)" />}
						</g>
						{r.tufts.map((t) => <path d={t.d} fill={t.fill} />)}
					</g>
				))
			}

			{
				vines.map((v) => (
					<g>
						<path d={v.d} fill="none" stroke="var(--door-moss)" stroke-width="3" stroke-linecap="round" />
						{v.leaves.map((l, j) => (
							<ellipse
								cx={f(l.x)}
								cy={f(l.y)}
								rx={f(l.size)}
								ry={f(l.size * 0.5)}
								transform={`rotate(${l.angle} ${f(l.x)} ${f(l.y)})`}
								fill={leafTones[j % leafTones.length]}
							/>
						))}
					</g>
				))
			}

			{
				flowers.map((fl) => (
					<g>
						<circle cx={f(fl.x)} cy={f(fl.y)} r={f(fl.r)} fill="var(--door-flower)" />
						<circle cx={f(fl.x)} cy={f(fl.y)} r={f(fl.r * 0.35)} fill="var(--door-flower-centre)" />
					</g>
				))
			}

			<rect x={-W} y={-H} width={W * 3} height={H * 3} fill="url(#door-vignette)" pointer-events="none" />

			{
				fireflies.map((ff) => (
					<g
						class="door-firefly"
						style={`--dx: ${f(ff.dx)}px; --dy: ${f(ff.dy)}px; animation-delay: -${f(ff.delay)}s; animation-duration: ${f(ff.duration)}s`}
					>
						<circle cx={f(ff.x)} cy={f(ff.y)} r={f(ff.size * 6)} fill="url(#door-firefly-glow)" />
						<circle cx={f(ff.x)} cy={f(ff.y)} r={f(ff.size)} fill="var(--door-glow)" />
					</g>
				))
			}
		</svg>
	</div>

	<p class="door-hint">Scroll to enter <span>↓</span></p>
</div>

<script>
	const intro = document.querySelector<HTMLElement>('.door-intro');
	const root = document.documentElement;

	if (intro && root.classList.contains('door-closed')) {
		const scene = intro.querySelector<HTMLElement>('.door-scene')!;
		const left = intro.querySelector<SVGGElement>('.door-left')!;
		const right = intro.querySelector<SVGGElement>('.door-right')!;
		const seam = intro.querySelector<SVGLineElement>('.door-seam')!;
		const hint = intro.querySelector<HTMLElement>('.door-hint')!;
		const shafts = intro.querySelector<SVGGElement>('.door-shafts')!;

		const clamp = (v: number) => Math.min(1, Math.max(0, v));
		const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

		// p is the shown progress, easing toward target, which input drives
		let p = 0;
		let target = 0;
		let committed = false;
		let finished = false;
		let lastInput = 0;
		let lastFrame = 0;
		let frame = 0;
		let endZoom = 6;
		let touchY = 0;

		window.scrollTo(0, 0);

		const svg = scene.querySelector('svg')!;
		const canopy = intro.querySelectorAll<SVGGElement>('.door-canopy');

		const measure = () => {
			// On tall screens, cropping to fill the height would cut off the archway,
			// so fit its width instead and let the dark wall run above and below
			const aspect = innerWidth / innerHeight;
			let scale: number;
			if (1000 * aspect < 820) {
				const height = 820 / aspect;
				svg.setAttribute('viewBox', `390 ${500 - height / 2} 820 ${height}`);
				scale = innerWidth / 820;
				// The canopy would hang partway down a tall screen, so leave it out
				canopy.forEach((g) => (g.style.display = 'none'));
			} else {
				svg.setAttribute('viewBox', '0 0 1600 1000');
				scale = Math.max(innerWidth / 1600, innerHeight / 1000);
				canopy.forEach((g) => (g.style.display = ''));
			}
			// Zoom far enough that the opening covers the whole screen
			endZoom = (Math.hypot(innerWidth, innerHeight) / 2 / (214 * scale)) * 1.2;
		};

		const render = () => {
			const open = easeInOut(clamp((p - 0.06) / 0.5));
			left.style.transform = `translateX(${-open * 230}px)`;
			right.style.transform = `translateX(${open * 230}px)`;
			// Light leaks through the seam as the door unlocks, then fades as it parts
			seam.style.opacity = `${clamp(p / 0.06) * (1 - open)}`;
			scene.style.transform = `scale(${1 + (endZoom - 1) * Math.pow(p, 2.2)})`;
			intro.style.opacity = `${1 - clamp((p - 0.8) / 0.2)}`;
			hint.style.opacity = `${1 - clamp(p / 0.08)}`;
			// The light shafts are costly to repaint while zooming, so fade them out first
			const shaftFade = 1 - clamp(p / 0.12);
			shafts.style.opacity = `${shaftFade}`;
			shafts.style.display = shaftFade ? '' : 'none';
			// Let the page's own entrance animations play as it comes into view
			if (p > 0.45) root.classList.remove('door-hold');
		};

		const finish = () => {
			if (finished) return;
			finished = true;
			cancelAnimationFrame(frame);
			try {
				sessionStorage.setItem('door-opened', '1');
			} catch {}
			root.classList.remove('door-closed', 'door-hold');
			intro.remove();
			// Swallow trailing trackpad momentum so the page doesn't lurch once it's open
			setTimeout(() => {
				window.removeEventListener('wheel', onWheel);
				window.removeEventListener('touchmove', onTouchMove);
			}, 600);
			window.removeEventListener('keydown', onKey);
			window.removeEventListener('resize', measure);
		};

		const commit = () => {
			committed = true;
			target = 1;
		};

		const nudge = (amount: number) => {
			if (committed || finished) return;
			target = clamp(target + amount);
			lastInput = performance.now();
			if (target > 0.5) commit();
		};

		const onWheel = (event: WheelEvent) => {
			event.preventDefault();
			const lines = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? innerHeight : 1;
			nudge((event.deltaY * lines) / 1100);
		};

		const onTouchStart = (event: TouchEvent) => {
			touchY = event.touches[0].clientY;
		};

		const onTouchMove = (event: TouchEvent) => {
			event.preventDefault();
			const y = event.touches[0].clientY;
			nudge((touchY - y) / 450);
			touchY = y;
		};

		const onKey = (event: KeyboardEvent) => {
			if (event.metaKey || event.ctrlKey || event.altKey) return;
			if (event.key === 'Escape') return finish();
			if (event.key === 'Tab') return;
			event.preventDefault();
			commit();
		};

		const tick = (now: number) => {
			const dt = lastFrame ? Math.min(0.05, (now - lastFrame) / 1000) : 0;
			lastFrame = now;

			// Once input pauses, either carry on through the door or settle back
			if (!committed && target > 0 && now - lastInput > 200) {
				if (target > 0.12) commit();
				else target = 0;
			}

			const step = (target - p) * (1 - Math.exp(-(committed ? 3.5 : 10) * dt));
			// Keep a minimum pace once committed so the end doesn't drag
			p = committed ? Math.min(target, p + Math.max(step, 0.45 * dt)) : p + step;
			render();

			if (committed && p >= 0.999) return finish();
			frame = requestAnimationFrame(tick);
		};

		measure();
		render();
		window.addEventListener('wheel', onWheel, { passive: false });
		window.addEventListener('touchstart', onTouchStart, { passive: true });
		window.addEventListener('touchmove', onTouchMove, { passive: false });
		window.addEventListener('keydown', onKey);
		window.addEventListener('resize', measure);
		intro.addEventListener('click', commit);
		frame = requestAnimationFrame(tick);
	}
</script>

<style>
	.door-intro {
		--door-wall: #070a06;
		--door-wall-light: #141a11;
		--door-trunk: #1d2618;
		--door-trunk-dark: #0b0f09;
		--door-trunk-light: #46573a;
		--door-trunk-far: #182217;
		--door-trunk-far-light: #26341f;
		--door-rock-far: #182116;
		--door-canopy: #060905;
		--door-canopy-far: #0e150c;
		--door-fog: #3d4f3a;
		--door-shaft: #d9eaa0;
		--door-halo: #8fb85a;
		--door-rock: #5c6452;
		--door-rock-light: #7f8971;
		--door-rock-dark: #343a2e;
		--door-moss: #6f9a3e;
		--door-moss-dark: #3c5e2c;
		--door-moss-light: #a6c257;
		--door-metal: #222a24;
		--door-metal-light: #4a574b;
		--door-metal-dark: #151a16;
		--door-panel: #2e3a34;
		--door-flower: #e4dfc6;
		--door-flower-centre: #c9a548;
		--door-glow: #d6e678;

		display: none;
		position: fixed;
		inset: 0;
		z-index: 100;
		overflow: hidden;
		cursor: pointer;
		touch-action: none;
	}

	@media (prefers-color-scheme: light) {
		.door-intro {
			--door-wall: #1d2619;
			--door-wall-light: #34422b;
			--door-trunk: #2f3b25;
			--door-trunk-dark: #1a2213;
			--door-trunk-light: #63764f;
			--door-trunk-far: #3a4a31;
			--door-trunk-far-light: #4c5e40;
			--door-rock-far: #3a4933;
			--door-canopy: #18210f;
			--door-canopy-far: #2a3820;
			--door-fog: #7d9070;
			--door-shaft: #eef5c8;
			--door-halo: #b7d77a;
			--door-rock: #8a9279;
			--door-rock-light: #aab296;
			--door-rock-dark: #5d6550;
			--door-moss: #6f9a3e;
			--door-metal: #333d36;
			--door-metal-light: #66756a;
			--door-metal-dark: #20271f;
			--door-panel: #42514a;
		}
	}

	:global(html.door-closed) .door-intro {
		display: block;
	}

	.door-scene {
		position: absolute;
		inset: 0;
		transform-origin: 50% 50%;
		will-change: transform;
	}

	svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	.door-left,
	.door-right {
		will-change: transform;
	}

	.door-seam {
		stroke: var(--door-glow);
		stroke-width: 3;
		opacity: 0;
		filter: drop-shadow(0 0 6px var(--door-glow));
	}

	.door-monogram {
		font-family: var(--font-display);
		font-style: italic;
		font-size: 44px;
		fill: var(--door-moss);
		opacity: 0.9;
	}

	.door-firefly {
		animation: door-firefly 6s ease-in-out infinite;
	}

	.door-shaft {
		transform-box: view-box;
		animation: door-shaft 12s ease-in-out infinite;
	}

	@keyframes door-shaft {
		0%,
		100% {
			transform: rotate(-2.5deg);
			opacity: 1;
		}
		50% {
			transform: rotate(2.5deg);
			opacity: 0.45;
		}
	}

	@keyframes door-firefly {
		0%,
		100% {
			opacity: 0;
			transform: translate(0, 0);
		}
		50% {
			opacity: 0.9;
			transform: translate(var(--dx), var(--dy));
		}
	}

	.door-hint {
		position: absolute;
		left: 50%;
		bottom: 2.5rem;
		translate: -50% 0;
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--door-flower);
		text-shadow: 0 1px 8px rgb(0 0 0 / 0.6);
		pointer-events: none;
	}

	.door-hint span {
		display: inline-block;
		margin-left: 0.3em;
		animation: door-bob 1.6s ease-in-out infinite;
	}

	@keyframes door-bob {
		50% {
			transform: translateY(5px);
		}
	}
</style>
