---
// Entrance: a round stone door set in a mossy rock archway. Scrolling (or a
// tap, click, or key) pushes in toward the door as it slides open, revealing
// the page behind. Plays once per browser session; add ?intro to replay it.

// Scene is drawn on a 1600×1000 canvas with the door at its centre
const W = 1600;
const H = 1000;
const CX = W / 2;
const CY = H / 2;
// Radius of the opening in the rock, and of the door filling it
const HOLE = 214;
const DOOR = 220;

import { deflateSync } from 'node:zlib';

// Deterministic randomness so the rocks keep their shape between visits
let seed = 7;
const rand = () => {
	seed = (seed * 16807) % 2147483647;
	return (seed - 1) / 2147483646;
};
const between = (lo: number, hi: number) => lo + rand() * (hi - lo);
// Surface detail draws from its own sequence so it doesn't reshape the rocks
let detailSeed = 23;
const detail = () => {
	detailSeed = (detailSeed * 16807) % 2147483647;
	return (detailSeed - 1) / 2147483646;
};
const detailBetween = (lo: number, hi: number) => lo + detail() * (hi - lo);
const f = (n: number) => n.toFixed(1);

// A lumpy closed shape around a centre, smoothed with Catmull-Rom curves
const blob = (cx: number, cy: number, rx: number, ry: number, lumps = 9, jitter = 0.2) => {
	const pts = Array.from({ length: lumps }, (_, i) => {
		const a = (i / lumps) * Math.PI * 2;
		const r = 1 - jitter / 2 + rand() * jitter;
		return [cx + Math.cos(a) * rx * r, cy + Math.sin(a) * ry * r];
	});
	let d = `M${f(pts[0][0])} ${f(pts[0][1])}`;
	for (let i = 0; i < lumps; i++) {
		const p0 = pts[(i - 1 + lumps) % lumps];
		const p1 = pts[i];
		const p2 = pts[(i + 1) % lumps];
		const p3 = pts[(i + 2) % lumps];
		const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
		const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
		d += ` C${f(c1[0])} ${f(c1[1])} ${f(c2[0])} ${f(c2[1])} ${f(p2[0])} ${f(p2[1])}`;
	}
	return d + 'Z';
};

// Tiny RGBA PNG encoder, used to bake grain textures at build time. A live
// SVG noise filter would be recomputed on every frame of the zoom.
const crcTable = Array.from({ length: 256 }, (_, n) => {
	let c = n;
	for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
	return c >>> 0;
});
const crc = (buf: Buffer) => {
	let c = 0xffffffff;
	for (const b of buf) c = crcTable[(c ^ b) & 0xff] ^ (c >>> 8);
	return (c ^ 0xffffffff) >>> 0;
};
const chunk = (type: string, data: Buffer) => {
	const len = Buffer.alloc(4);
	len.writeUInt32BE(data.length);
	const body = Buffer.concat([Buffer.from(type), data]);
	const sum = Buffer.alloc(4);
	sum.writeUInt32BE(crc(body));
	return Buffer.concat([len, body, sum]);
};
const png = (size: number, pixel: (x: number, y: number) => [number, number, number, number]) => {
	const raw = Buffer.alloc(size * (size * 4 + 1));
	for (let y = 0; y < size; y++)
		for (let x = 0; x < size; x++) raw.set(pixel(x, y), y * (size * 4 + 1) + 1 + x * 4);
	const header = Buffer.alloc(13);
	header.writeUInt32BE(size, 0);
	header.writeUInt32BE(size, 4);
	header.set([8, 6, 0, 0, 0], 8);
	const file = Buffer.concat([
		Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]),
		chunk('IHDR', header),
		chunk('IDAT', deflateSync(raw)),
		chunk('IEND', Buffer.alloc(0)),
	]);
	return `data:image/png;base64,${file.toString('base64')}`;
};

// Fine specks, some dark and some pale, like a stippled print
const specks = png(128, () => {
	const v = detail();
	if (v < 0.13) return [20, 24, 16, Math.round(55 + detail() * 75)];
	if (v > 0.93) return [236, 240, 220, Math.round(40 + detail() * 70)];
	return [0, 0, 0, 0];
});
// Broad blotches: a coarse grid of random shades, smoothed out when stretched
const mottle = png(32, () => [16, 20, 12, Math.round(Math.max(0, detail() - 0.35) * 150)]);

// A spiky clump of leaves, alternating long and short points
const tuft = (cx: number, cy: number, size: number) => {
	const points = 9 + Math.floor(detail() * 5);
	let d = '';
	for (let i = 0; i < points * 2; i++) {
		const a = (i / (points * 2)) * Math.PI * 2 + detailBetween(-0.15, 0.15);
		const r = size * (i % 2 ? detailBetween(0.25, 0.45) : detailBetween(0.6, 1.15));
		// Points reach up more than down, like leaves growing toward the light
		const squash = Math.sin(a) > 0 ? 0.55 : 1;
		d += `${i ? 'L' : 'M'}${f(cx + Math.cos(a) * r)} ${f(cy + Math.sin(a) * r * squash)}`;
	}
	return d + 'Z';
};

const leafTones = ['var(--door-moss-dark)', 'var(--door-moss)', 'var(--door-moss)', 'var(--door-moss-light)'];

interface Rock {
	shadow: string;
	body: string;
	shade: string;
	light: string;
	sheen: string;
	pits: string[];
	crack: string;
	crackWidth: number;
	moss?: string;
	tufts: { d: string; fill: string }[];
}

const rock = (cx: number, cy: number, rx: number, ry: number, mossy: boolean): Rock => {
	const shadow = blob(cx + 4, cy + ry * 0.12, rx * 1.02, ry, 9, 0.18);
	const body = blob(cx, cy, rx, ry, 9, 0.2);
	const light = blob(cx - rx * 0.18, cy - ry * 0.3, rx * 0.6, ry * 0.42, 7, 0.3);
	const moss = mossy ? blob(cx - rx * 0.05, cy - ry * 0.62, rx * 0.62, ry * 0.26, 8, 0.45) : undefined;

	// Extra planes of light and shadow, a few pits, and a crack, so the faces aren't flat
	const shadeBlob = (ox: number, oy: number, sx: number, sy: number) =>
		blob(cx + rx * ox, cy + ry * oy, rx * sx, ry * sy, 7, 0.4);
	const shade = shadeBlob(0.28, 0.32, 0.5, 0.34);
	const sheen = shadeBlob(detailBetween(-0.4, -0.1), detailBetween(-0.45, -0.3), 0.26, 0.12);
	const pits = Array.from({ length: 2 + Math.floor(detail() * 3) }, () =>
		shadeBlob(detailBetween(-0.55, 0.55), detailBetween(-0.1, 0.55), detailBetween(0.04, 0.1), detailBetween(0.03, 0.07)),
	);
	let x = cx + rx * detailBetween(-0.35, 0.35);
	let y = cy - ry * detailBetween(0.05, 0.25);
	let crack = `M${f(x)} ${f(y)}`;
	for (let i = 0; i < 4; i++) {
		x += rx * detailBetween(-0.1, 0.1);
		y += ry * detailBetween(0.08, 0.15);
		crack += `L${f(x)} ${f(y)}`;
	}

	// Leafy clumps along the moss, in a mix of greens
	const tufts = mossy
		? Array.from({ length: Math.round(rx / 14) }, () => ({
				d: tuft(
					cx - rx * 0.05 + rx * 0.62 * detailBetween(-0.85, 0.85),
					cy - ry * 0.62 + ry * 0.26 * detailBetween(-0.9, 0.5),
					rx * detailBetween(0.06, 0.14),
				),
				fill: leafTones[Math.floor(detail() * leafTones.length)],
			}))
		: [];

	return { shadow, body, shade, light, sheen, pits, crack, crackWidth: Math.max(1.5, rx * 0.012), moss, tufts };
};

// Big boulders framing the scene at either side, drawn first
const boulders: Rock[] = [
	rock(120, 250, 300, 230, true),
	rock(90, 640, 280, 260, false),
	rock(250, 960, 360, 200, true),
	rock(1480, 260, 300, 240, true),
	rock(1520, 650, 270, 250, false),
	rock(1350, 970, 360, 190, true),
];

// A ring of stones around the opening, overlapping the door's edge
const ring: Rock[] = [];
const ringCount = 15;
for (let i = 0; i < ringCount; i++) {
	const a = (i / ringCount) * Math.PI * 2 - Math.PI / 2 + between(-0.08, 0.08);
	const dist = HOLE + between(48, 70);
	const cx = CX + Math.cos(a) * dist;
	const cy = CY + Math.sin(a) * dist * 0.96;
	ring.push(rock(cx, cy, between(72, 100), between(58, 82), Math.sin(a) < -0.2));
}

// Tree trunks fading into the dark behind the rocks
const trunks = [
	{ x: 330, w: 70 },
	{ x: 470, w: 46 },
	{ x: 560, w: 30 },
	{ x: 1060, w: 34 },
	{ x: 1160, w: 52 },
	{ x: 1290, w: 78 },
];

// Vines hanging from the stones over the top of the door
const vines = [-2.05, -1.72, -1.25, -0.95].map((a, i) => {
	const x = CX + Math.cos(a) * (HOLE + 30);
	const y = CY + Math.sin(a) * (HOLE + 30);
	const length = 120 + i * 37 + between(0, 50);
	const sway = between(-26, 26);
	const d = `M${f(x)} ${f(y)} C${f(x + sway)} ${f(y + length * 0.35)} ${f(x - sway)} ${f(y + length * 0.7)} ${f(x + sway * 0.4)} ${f(y + length)}`;
	const leaves = Array.from({ length: 6 }, (_, j) => {
		const t = (j + 1) / 7;
		const lx = x + sway * Math.sin(t * Math.PI) * (t < 0.5 ? 1 : -0.6);
		const ly = y + length * t;
		return { x: lx + (j % 2 ? 7 : -7), y: ly, angle: j % 2 ? 35 : -35, size: 7 + rand() * 4 };
	});
	return { d, leaves };
});

// Little clusters of pale flowers on the boulders
const flowerSpots = [
	[150, 120],
	[250, 420],
	[60, 520],
	[330, 830],
	[1440, 120],
	[1350, 420],
	[1560, 520],
	[1270, 850],
];
const flowers = flowerSpots.flatMap(([x, y]) =>
	Array.from({ length: 3 + Math.floor(rand() * 3) }, () => ({
		x: x + between(-34, 34),
		y: y + between(-24, 24),
		r: between(5, 9),
	})),
);

// Door hardware: six spokes around a central octagon, and rivets on the rim
const spokes = [30, 90, 150, 210, 270, 330].map((deg) => {
	const a = (deg * Math.PI) / 180;
	return { x1: CX + Math.cos(a) * 62, y1: CY + Math.sin(a) * 62, x2: CX + Math.cos(a) * 196, y2: CY + Math.sin(a) * 196 };
});
const octagon = (r: number) =>
	Array.from({ length: 8 }, (_, i) => {
		const a = (i / 8) * Math.PI * 2 + Math.PI / 8;
		return `${f(CX + Math.cos(a) * r)},${f(CY + Math.sin(a) * r)}`;
	}).join(' ');
const rivets = Array.from({ length: 24 }, (_, i) => {
	const a = (i / 24) * Math.PI * 2 + Math.PI / 24;
	return { x: CX + Math.cos(a) * 207, y: CY + Math.sin(a) * 207 };
});

const fireflies = Array.from({ length: 16 }, () => ({
	x: between(80, 1520),
	y: between(80, 920),
	delay: between(0, 6),
	duration: between(4, 8),
}));
---

<div class="door-intro" aria-hidden="true">
	<div class="door-scene">
		<svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice">
			<defs>
				<radialGradient id="door-wall" cx="50%" cy="50%" r="70%">
					<stop offset="0%" stop-color="var(--door-wall-light)" />
					<stop offset="100%" stop-color="var(--door-wall)" />
				</radialGradient>
				<radialGradient id="door-metal" cx="40%" cy="35%" r="75%">
					<stop offset="0%" stop-color="var(--door-metal-light)" />
					<stop offset="100%" stop-color="var(--door-metal)" />
				</radialGradient>
				<!-- Grain laid over the rocks and leaves -->
				<pattern id="door-specks" patternUnits="userSpaceOnUse" width="128" height="128">
					<image href={specks} width="128" height="128" style="image-rendering: pixelated" />
				</pattern>
				<pattern id="door-mottle" patternUnits="userSpaceOnUse" width="640" height="640">
					<image href={mottle} width="640" height="640" />
				</pattern>
				<clipPath id="door-hole">
					<circle cx={CX} cy={CY} r={HOLE} />
				</clipPath>
				<clipPath id="door-left-half">
					<rect x="0" y="0" width={CX} height={H} />
				</clipPath>
				<clipPath id="door-right-half">
					<rect x={CX} y="0" width={CX} height={H} />
				</clipPath>
				<g id="door-face">
					<circle cx={CX} cy={CY} r={DOOR} fill="url(#door-metal)" />
					<circle cx={CX} cy={CY} r="196" fill="var(--door-panel)" />
					<circle cx={CX} cy={CY} r="124" fill="none" stroke="var(--door-metal-dark)" stroke-width="2" opacity="0.6" />
					{
						spokes.map((s) => (
							<line x1={f(s.x1)} y1={f(s.y1)} x2={f(s.x2)} y2={f(s.y2)} stroke="var(--door-metal-dark)" stroke-width="26" stroke-linecap="round" />
						))
					}
					{
						spokes.map((s) => (
							<line x1={f(s.x1)} y1={f(s.y1)} x2={f(s.x2)} y2={f(s.y2)} stroke="var(--door-metal-light)" stroke-width="8" stroke-linecap="round" opacity="0.5" />
						))
					}
					<circle cx={CX} cy={CY} r="200" fill="none" stroke="var(--door-metal-dark)" stroke-width="16" />
					<polygon points={octagon(70)} fill="var(--door-metal-dark)" />
					<polygon points={octagon(54)} fill="var(--door-panel)" stroke="var(--door-metal-light)" stroke-width="2" />
					<text x={CX} y={CY + 15} text-anchor="middle" class="door-monogram">YX</text>
					{rivets.map((r) => <circle cx={f(r.x)} cy={f(r.y)} r="3.5" fill="var(--door-metal-light)" />)}
					<path d={blob(CX - 120, CY - 168, 60, 22, 8, 0.5)} fill="var(--door-moss)" opacity="0.75" />
					<path d={blob(CX + 96, CY - 178, 48, 18, 8, 0.5)} fill="var(--door-moss)" opacity="0.7" />
				</g>
			</defs>

			<!-- Dark forest wall with the opening cut out of it -->
			<path
				fill="url(#door-wall)"
				fill-rule="evenodd"
				d={`M${-W} ${-H}H${W * 2}V${H * 2}H${-W}Z M${CX - HOLE} ${CY} a${HOLE} ${HOLE} 0 1 0 ${HOLE * 2} 0 a${HOLE} ${HOLE} 0 1 0 ${-HOLE * 2} 0Z`}
			/>
			{trunks.map((t) => <rect x={t.x - t.w / 2} y={-H} width={t.w} height={H * 3} rx={t.w / 2} fill="var(--door-trunk)" />)}

			<!-- The two halves of the door, which slide apart into the rock -->
			<g clip-path="url(#door-hole)">
				<g class="door-left">
					<use href="#door-face" clip-path="url(#door-left-half)" />
				</g>
				<g class="door-right">
					<use href="#door-face" clip-path="url(#door-right-half)" />
				</g>
				<line class="door-seam" x1={CX} y1={CY - HOLE} x2={CX} y2={CY + HOLE} />
			</g>

			{
				[...boulders, ...ring].map((r) => (
					<g>
						<path d={r.shadow} fill="var(--door-rock-dark)" />
						<path d={r.body} fill="var(--door-rock)" />
						<path d={r.shade} fill="var(--door-rock-dark)" opacity="0.45" />
						<path d={r.light} fill="var(--door-rock-light)" opacity="0.7" />
						<path d={r.sheen} fill="var(--door-rock-light)" opacity="0.6" />
						{r.pits.map((d) => <path d={d} fill="var(--door-rock-dark)" opacity="0.55" />)}
						<path
							d={r.crack}
							fill="none"
							stroke="var(--door-rock-dark)"
							stroke-width={f(r.crackWidth)}
							stroke-linecap="round"
							stroke-linejoin="round"
							opacity="0.7"
						/>
						{r.moss && <path d={r.moss} fill="var(--door-moss-dark)" opacity="0.9" />}
						{r.tufts.map((t) => <path d={t.d} fill={t.fill} />)}
						{['door-mottle', 'door-specks'].map((id) => (
							<path d={`${r.shadow}${r.body}${r.tufts.map((t) => t.d).join('')}`} fill={`url(#${id})`} />
						))}
					</g>
				))
			}

			{
				vines.map((v) => (
					<g>
						<path d={v.d} fill="none" stroke="var(--door-moss)" stroke-width="3" stroke-linecap="round" />
						{v.leaves.map((l, j) => (
							<ellipse
								cx={f(l.x)}
								cy={f(l.y)}
								rx={f(l.size)}
								ry={f(l.size * 0.5)}
								transform={`rotate(${l.angle} ${f(l.x)} ${f(l.y)})`}
								fill={leafTones[j % leafTones.length]}
							/>
						))}
					</g>
				))
			}

			{
				flowers.map((fl) => (
					<g>
						<circle cx={f(fl.x)} cy={f(fl.y)} r={f(fl.r)} fill="var(--door-flower)" />
						<circle cx={f(fl.x)} cy={f(fl.y)} r={f(fl.r * 0.35)} fill="var(--door-flower-centre)" />
					</g>
				))
			}

			{
				fireflies.map((ff) => (
					<circle
						class="door-firefly"
						cx={f(ff.x)}
						cy={f(ff.y)}
						r="3"
						style={`animation-delay: -${f(ff.delay)}s; animation-duration: ${f(ff.duration)}s`}
					/>
				))
			}
		</svg>
	</div>

	<p class="door-hint">Scroll to enter <span>↓</span></p>
</div>

<script>
	const intro = document.querySelector<HTMLElement>('.door-intro');
	const root = document.documentElement;

	if (intro && root.classList.contains('door-closed')) {
		const scene = intro.querySelector<HTMLElement>('.door-scene')!;
		const left = intro.querySelector<SVGGElement>('.door-left')!;
		const right = intro.querySelector<SVGGElement>('.door-right')!;
		const seam = intro.querySelector<SVGLineElement>('.door-seam')!;
		const hint = intro.querySelector<HTMLElement>('.door-hint')!;

		const clamp = (v: number) => Math.min(1, Math.max(0, v));
		const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

		// p is the shown progress, easing toward target, which input drives
		let p = 0;
		let target = 0;
		let committed = false;
		let finished = false;
		let lastInput = 0;
		let lastFrame = 0;
		let frame = 0;
		let endZoom = 6;
		let touchY = 0;

		window.scrollTo(0, 0);

		const svg = scene.querySelector('svg')!;

		const measure = () => {
			// On tall screens, cropping to fill the height would cut off the archway,
			// so fit its width instead and let the dark wall run above and below
			const aspect = innerWidth / innerHeight;
			let scale: number;
			if (1000 * aspect < 820) {
				const height = 820 / aspect;
				svg.setAttribute('viewBox', `390 ${500 - height / 2} 820 ${height}`);
				scale = innerWidth / 820;
			} else {
				svg.setAttribute('viewBox', '0 0 1600 1000');
				scale = Math.max(innerWidth / 1600, innerHeight / 1000);
			}
			// Zoom far enough that the opening covers the whole screen
			endZoom = (Math.hypot(innerWidth, innerHeight) / 2 / (214 * scale)) * 1.2;
		};

		const render = () => {
			const open = easeInOut(clamp((p - 0.06) / 0.5));
			left.style.transform = `translateX(${-open * 230}px)`;
			right.style.transform = `translateX(${open * 230}px)`;
			// Light leaks through the seam as the door unlocks, then fades as it parts
			seam.style.opacity = `${clamp(p / 0.06) * (1 - open)}`;
			scene.style.transform = `scale(${1 + (endZoom - 1) * Math.pow(p, 2.2)})`;
			intro.style.opacity = `${1 - clamp((p - 0.8) / 0.2)}`;
			hint.style.opacity = `${1 - clamp(p / 0.08)}`;
			// Let the page's own entrance animations play as it comes into view
			if (p > 0.45) root.classList.remove('door-hold');
		};

		const finish = () => {
			if (finished) return;
			finished = true;
			cancelAnimationFrame(frame);
			try {
				sessionStorage.setItem('door-opened', '1');
			} catch {}
			root.classList.remove('door-closed', 'door-hold');
			intro.remove();
			// Swallow trailing trackpad momentum so the page doesn't lurch once it's open
			setTimeout(() => {
				window.removeEventListener('wheel', onWheel);
				window.removeEventListener('touchmove', onTouchMove);
			}, 600);
			window.removeEventListener('keydown', onKey);
			window.removeEventListener('resize', measure);
		};

		const commit = () => {
			committed = true;
			target = 1;
		};

		const nudge = (amount: number) => {
			if (committed || finished) return;
			target = clamp(target + amount);
			lastInput = performance.now();
			if (target > 0.5) commit();
		};

		const onWheel = (event: WheelEvent) => {
			event.preventDefault();
			const lines = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? innerHeight : 1;
			nudge((event.deltaY * lines) / 1100);
		};

		const onTouchStart = (event: TouchEvent) => {
			touchY = event.touches[0].clientY;
		};

		const onTouchMove = (event: TouchEvent) => {
			event.preventDefault();
			const y = event.touches[0].clientY;
			nudge((touchY - y) / 450);
			touchY = y;
		};

		const onKey = (event: KeyboardEvent) => {
			if (event.metaKey || event.ctrlKey || event.altKey) return;
			if (event.key === 'Escape') return finish();
			if (event.key === 'Tab') return;
			event.preventDefault();
			commit();
		};

		const tick = (now: number) => {
			const dt = lastFrame ? Math.min(0.05, (now - lastFrame) / 1000) : 0;
			lastFrame = now;

			// Once input pauses, either carry on through the door or settle back
			if (!committed && target > 0 && now - lastInput > 200) {
				if (target > 0.12) commit();
				else target = 0;
			}

			const step = (target - p) * (1 - Math.exp(-(committed ? 3.5 : 10) * dt));
			// Keep a minimum pace once committed so the end doesn't drag
			p = committed ? Math.min(target, p + Math.max(step, 0.45 * dt)) : p + step;
			render();

			if (committed && p >= 0.999) return finish();
			frame = requestAnimationFrame(tick);
		};

		measure();
		render();
		window.addEventListener('wheel', onWheel, { passive: false });
		window.addEventListener('touchstart', onTouchStart, { passive: true });
		window.addEventListener('touchmove', onTouchMove, { passive: false });
		window.addEventListener('keydown', onKey);
		window.addEventListener('resize', measure);
		intro.addEventListener('click', commit);
		frame = requestAnimationFrame(tick);
	}
</script>

